<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><PublishSingleFile>false</PublishSingleFile><PublishTrimmed>false</PublishTrimmed>
    <Version>1.1.0</Version><AssemblyVersion>$(Version).0</AssemblyVersion><FileVersion>$(Version).0</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(S9T05TestMode)' == 'true'">
    <DefineConstants>$(DefineConstants);S9T05_TEST</DefineConstants>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\s9t05test\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\s9t05test\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StoreExpiryInspector.UpdateSafety\StoreExpiryInspector.UpdateSafety.csproj" GlobalPropertiesToRemove="S9T05TestMode">
      <AdditionalProperties Condition="'$(S9T05TestMode)' == 'true'">S9T07HardKillTestMode=true</AdditionalProperties>
    </ProjectReference>
    <InternalsVisibleTo Include="StoreExpiryInspector.Tests" />
  </ItemGroup>
</Project>
