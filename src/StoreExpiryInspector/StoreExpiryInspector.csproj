<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>StoreExpiryInspector</RootNamespace>
    <Version>1.0.2</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(S9T07TestMode)' == 'true'">
    <DefineConstants>$(DefineConstants);S9T07_TEST</DefineConstants>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\s9t07test\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(TargetFramework)\s9t07test\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreExpiryInspector.UpdateSafety\StoreExpiryInspector.UpdateSafety.csproj" />
    <Compile Remove="Application\Updates\SchemaUpgradeSnapshot.cs" />
    <Compile Remove="Application\Updates\UpgradeHealthAck.cs" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StoreExpiryInspector.Tests" />
  </ItemGroup>

  <Target Name="PublishIndependentUpdater" AfterTargets="Publish">
    <MSBuild Projects="..\StoreExpiryInspector.Updater\StoreExpiryInspector.Updater.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)Updater\;PublishProfile=" />
  </Target>

</Project>
