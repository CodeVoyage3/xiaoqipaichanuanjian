<Window x:Class="StoreExpiryInspector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StoreExpiryInspector.UI"
        Title="门店效期排查软件"
        Width="1280"
        Height="760"
        MinWidth="1024"
        MinHeight="600"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="Window_SizeChanged">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Window.Resources>
        <ui:StageLabelConverter x:Key="StageLabelConverter" />
        <ui:DateOnlyDisplayConverter x:Key="DateOnlyDisplayConverter" />
        <ui:Stage4BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:Stage4InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <DataTemplate x:Key="StageBadgeTemplate">
            <Border Padding="6,2"
                    Height="24"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                        <Setter Property="TextElement.Foreground" Value="#475569" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HighestStage}" Value="expired">
                                <Setter Property="Background" Value="#FDECEC" />
                                <Setter Property="BorderBrush" Value="#E5A3A8" />
                                <Setter Property="TextElement.Foreground" Value="#A4262C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="withdraw">
                                <Setter Property="Background" Value="#FFF0E5" />
                                <Setter Property="BorderBrush" Value="#F2B58B" />
                                <Setter Property="TextElement.Foreground" Value="#9A3412" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="discount_20">
                                <Setter Property="Background" Value="#FFF8D6" />
                                <Setter Property="BorderBrush" Value="#E5CE70" />
                                <Setter Property="TextElement.Foreground" Value="#7A5900" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="discount_50">
                                <Setter Property="Background" Value="#EAF2FF" />
                                <Setter Property="BorderBrush" Value="#9FC1F5" />
                                <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding HighestStage, Converter={StaticResource StageLabelConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,24,16,20">
                    <TextBlock Text="门店效期排查"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="库存与效期工作台"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="8,0,8,0">
                    <Button Content="首页"
                            Command="{Binding NavigateHomeCommand}"
                            Tag="{Binding IsDashboardVisible}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="待排查任务"
                            Command="{Binding NavigateTasksCommand}"
                            Tag="{Binding IsPendingTasksVisible}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="排查记录 · 后续阶段"
                            Command="{Binding NavigateHistoryCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="数据导入"
                            Command="{Binding NavigateImportCommand}"
                            Tag="{Binding IsImportVisible}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="设置 · 后续阶段"
                            Command="{Binding NavigateSettingsCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20,16,16,20">
                    <TextBlock Text="Stage 4"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="查询与数据导入"
                               FontSize="12"
                               Foreground="{DynamicResource DisabledTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding PageSubtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,24">
                            <Border Padding="12"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dashboard.IsStale}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Dashboard.HasError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Dashboard.LastImportText}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Dashboard.FreshnessWarningText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Dashboard.ErrorMessage}"
                                                   Visibility="{Binding Dashboard.HasError, Converter={StaticResource BoolToVisibility}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource WarningTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="刷新"
                                            Command="{Binding Dashboard.RefreshCommand}"
                                            Margin="12,0,0,0" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,20,0,8"
                                       Text="待排查概览"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <UniformGrid Columns="5">
                                <Border Margin="0,0,8,0"
                                        Padding="12,10"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="待排查"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Dashboard.OpenTaskCount}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,0"
                                        Padding="12,10"
                                        Background="#FDECEC"
                                        BorderBrush="#E5A3A8"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="过期" FontSize="12" Foreground="#A4262C" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Dashboard.ExpiredCount}" FontSize="20" FontWeight="SemiBold" Foreground="#A4262C" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,0"
                                        Padding="12,10"
                                        Background="#FFF0E5"
                                        BorderBrush="#F2B58B"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="收仓" FontSize="12" Foreground="#9A3412" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Dashboard.WithdrawCount}" FontSize="20" FontWeight="SemiBold" Foreground="#9A3412" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,0"
                                        Padding="12,10"
                                        Background="#FFF8D6"
                                        BorderBrush="#E5CE70"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="2折" FontSize="12" Foreground="#7A5900" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Dashboard.Discount20Count}" FontSize="20" FontWeight="SemiBold" Foreground="#7A5900" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="12,10"
                                        Background="#EAF2FF"
                                        BorderBrush="#9FC1F5"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="5折" FontSize="12" Foreground="#1D4ED8" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Dashboard.Discount50Count}" FontSize="20" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,24,0,8">
                                <TextBlock Text="最紧急任务"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <Button HorizontalAlignment="Right"
                                        Content="查看全部待排查任务"
                                        Command="{Binding Dashboard.ViewAllTasksCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0" />
                            </Grid>
                            <TextBlock Text="正在加载…"
                                       Visibility="{Binding Dashboard.IsLoading, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="暂无导入数据"
                                       Visibility="{Binding Dashboard.HasNoImportData, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="当前没有待排查任务"
                                       Visibility="{Binding Dashboard.HasNoOpenTasks, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Dashboard.UrgentTasks}"
                                      AutoGenerateColumns="False"
                                      Visibility="{Binding Dashboard.HasError, Converter={StaticResource InverseBoolToVisibility}}"
                                      IsTabStop="False"
                                      Focusable="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="阶段" Width="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource StageBadgeTemplate}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="*" />
                                    <DataGridTextColumn Header="商品编码" Binding="{Binding ProductCode}" Width="150" />
                                    <DataGridTextColumn Header="批次数" Binding="{Binding PendingBatchCount}" Width="80" />
                                    <DataGridTextColumn Header="库存" Binding="{Binding EffectiveStockQty}" Width="80" />
                                    <DataGridTextColumn Header="最近有效日期"
                                                         Binding="{Binding NearestExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                         Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsPendingTasksVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,8,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="待排查任务"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Margin="12,4,0,0"
                                       Text="{Binding PendingTasks.TotalCount, StringFormat=共 {0} 个商品}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TaskSearchBox"
                                 Text="{Binding PendingTasks.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索商品名称、编码或条码">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding PendingTasks.SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="搜索"
                                Command="{Binding PendingTasks.SearchCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="阶段"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PendingTasks.StageFilters}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="CanonicalStage"
                                  SelectedValue="{Binding PendingTasks.SelectedStage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="3"
                                Content="清空筛选"
                                Command="{Binding PendingTasks.ClearFiltersCommand}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock Text="正在加载…"
                                   Visibility="{Binding PendingTasks.IsLoading, Converter={StaticResource BoolToVisibility}}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding PendingTasks.HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PendingTasks.ErrorMessage}"
                                       FontSize="13"
                                       Foreground="#A4262C"
                                       VerticalAlignment="Center" />
                            <Button Content="重试"
                                    Command="{Binding PendingTasks.RetryCommand}"
                                    Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="没有符合当前条件的任务"
                                   Visibility="{Binding PendingTasks.IsFilterEmpty, Converter={StaticResource BoolToVisibility}}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="当前没有待排查任务"
                                   Visibility="{Binding PendingTasks.IsDatabaseEmpty, Converter={StaticResource BoolToVisibility}}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>

                    <DataGrid Grid.Row="4"
                              ItemsSource="{Binding PendingTasks.Items}"
                              AutoGenerateColumns="False"
                              Visibility="{Binding PendingTasks.HasError, Converter={StaticResource InverseBoolToVisibility}}"
                              IsTabStop="False"
                              Focusable="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="最高阶段" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource StageBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="商品编码" Binding="{Binding ProductCode}" Width="150" />
                            <DataGridTextColumn Header="待排查批次数" Binding="{Binding PendingBatchCount}" Width="108" />
                            <DataGridTextColumn Header="库存总数" Binding="{Binding EffectiveStockQty}" Width="88" />
                            <DataGridTextColumn Header="最近有效日期"
                                                 Binding="{Binding NearestExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                 Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="5" Margin="0,12,0,16">
                        <TextBlock Text="{Binding PendingTasks.PageSummary}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="上一页"
                                    Command="{Binding PendingTasks.PreviousPageCommand}"
                                    IsEnabled="{Binding PendingTasks.CanGoPrevious}"
                                    Margin="0,0,8,0" />
                            <Button Content="下一页"
                                    Command="{Binding PendingTasks.NextPageCommand}"
                                    IsEnabled="{Binding PendingTasks.CanGoNext}"
                                    Margin="0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsImportVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,24">
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="数据导入"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="选择标准 .xlsx 文件，先预览再确认"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Content="选择 Excel"
                                        Click="SelectExcel_Click"
                                        IsEnabled="{Binding Import.CanSelectFile}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0" />
                            </Grid>

                            <Border Padding="14"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Import.SelectedFileName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding Import.StatusMessage}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding Import.ErrorMessage}"
                                                   Visibility="{Binding Import.HasError, Converter={StaticResource BoolToVisibility}}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="#A4262C" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding Import.RefreshErrorMessage}"
                                                   Visibility="{Binding Import.HasRefreshError, Converter={StaticResource BoolToVisibility}}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource WarningTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="正在处理…"
                                                   Visibility="{Binding Import.IsLoading, Converter={StaticResource BoolToVisibility}}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,12,0" />
                                        <Button Content="重试"
                                                Command="{Binding Import.RetryCommand}"
                                                Visibility="{Binding Import.CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                Margin="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,0"
                                  Visibility="{Binding Import.HasPreview, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="4">
                                    <Border Margin="0,0,8,8"
                                            Padding="12,10"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="涉及商品"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding Import.InvolvedProductCount}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,8,8"
                                            Padding="12,10"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="正常批次键"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding Import.NormalBatchKeyCount}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,8,8"
                                            Padding="12,10"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="新增 / 更新商品"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Import.NewProductCount}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text=" / "
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="{Binding Import.UpdatedProductCount}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,0,8"
                                            Padding="12,10"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="新增 / 更新批次"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Import.NewBatchCount}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text=" / "
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="{Binding Import.UpdatedBatchCount}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="1" Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="行与规划问题均按既有 Application 结果展示"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Import.ChangeStatusText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Margin="12,0,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="确认导入"
                                            Command="{Binding Import.ConfirmCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0" />
                                </Grid>

                                <UniformGrid Grid.Row="2" Columns="6">
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="跳过行" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.SkippedRowCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="行问题" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.RowIssueCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="重复行" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.DuplicateRowCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="批次冲突" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.BatchConflictCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="库存冲突" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.StockConflictCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="规划问题" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.PlanningIssueCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>

                            <TextBlock Margin="0,16,0,8"
                                       Text="异常与警告明细"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Visibility="{Binding Import.HasWarningDetails, Converter={StaticResource BoolToVisibility}}" />
                            <Expander Header="行问题"
                                      IsExpanded="True"
                                      Visibility="{Binding Import.HasRowIssues, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.RowIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding ExcelRowNumber, StringFormat=第 {0} 行}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding FieldName, StringFormat=字段：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding Summary}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="跳过行"
                                      IsExpanded="False"
                                      Visibility="{Binding Import.HasSkippedRows, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.SkippedRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding ExcelRowNumber, StringFormat=第 {0} 行}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding OriginalProductCategory, StringFormat=商品大类：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="重复行"
                                      IsExpanded="False"
                                      Visibility="{Binding Import.HasDuplicateRows, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.DuplicateRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                                <TextBlock Text="{Binding DuplicateRowNumber, StringFormat=第 {0} 行与第 }"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding RepresentativeRowNumber, StringFormat={}{0} 行重复}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="规划问题"
                                      IsExpanded="True"
                                      Visibility="{Binding Import.HasPlanningIssues, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.PlanningIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding ProductCode, StringFormat=商品编码：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding ExcelRowNumber, StringFormat=行号：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding FieldName, StringFormat=字段：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding SafeSummary}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="批次冲突"
                                      IsExpanded="False"
                                      Visibility="{Binding Import.HasBatchConflicts, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.BatchConflicts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding BatchKey.ProductCode, StringFormat=商品编码：{0}}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <ItemsControl ItemsSource="{Binding DifferingFields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat=差异字段：{0}}"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="库存冲突"
                                      IsExpanded="False"
                                      Visibility="{Binding Import.HasStockConflicts, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Import.Preview.StockConflicts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding ProductCode, StringFormat=商品编码：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <ItemsControl ItemsSource="{Binding Values}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Value, StringFormat=库存值：{0}；行号：}"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                <ItemsControl ItemsSource="{Binding RowNumbers}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding StringFormat={}{0} }"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
