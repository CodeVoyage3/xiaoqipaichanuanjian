<Window x:Class="StoreExpiryInspector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StoreExpiryInspector.UI"
        Title="门店效期排查软件"
        Width="1280"
        Height="760"
        MinWidth="1024"
        MinHeight="600"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Language="zh-CN"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="Window_SizeChanged">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Window.Resources>
        <ui:StageLabelConverter x:Key="StageLabelConverter" />
        <ui:DateOnlyDisplayConverter x:Key="DateOnlyDisplayConverter" />
        <ui:Stage4BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:Stage4InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <DataTemplate x:Key="StageBadgeTemplate">
            <Border Padding="6,2"
                    Height="24"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                        <Setter Property="TextElement.Foreground" Value="#475569" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HighestStage}" Value="expired">
                                <Setter Property="Background" Value="#FDECEC" />
                                <Setter Property="BorderBrush" Value="#E5A3A8" />
                                <Setter Property="TextElement.Foreground" Value="#A4262C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="withdraw">
                                <Setter Property="Background" Value="#FFF0E5" />
                                <Setter Property="BorderBrush" Value="#F2B58B" />
                                <Setter Property="TextElement.Foreground" Value="#9A3412" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="discount_20">
                                <Setter Property="Background" Value="#FFF8D6" />
                                <Setter Property="BorderBrush" Value="#E5CE70" />
                                <Setter Property="TextElement.Foreground" Value="#7A5900" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="discount_50">
                                <Setter Property="Background" Value="#EAF2FF" />
                                <Setter Property="BorderBrush" Value="#9FC1F5" />
                                <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding HighestStage, Converter={StaticResource StageLabelConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DetailStageBadgeTemplate">
            <Border Padding="6,2"
                    Height="24"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                        <Setter Property="TextElement.Foreground" Value="#475569" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="expired">
                                <Setter Property="Background" Value="#FDECEC" />
                                <Setter Property="BorderBrush" Value="#E5A3A8" />
                                <Setter Property="TextElement.Foreground" Value="#A4262C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="withdraw">
                                <Setter Property="Background" Value="#FFF0E5" />
                                <Setter Property="BorderBrush" Value="#F2B58B" />
                                <Setter Property="TextElement.Foreground" Value="#9A3412" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="discount_20">
                                <Setter Property="Background" Value="#FFF8D6" />
                                <Setter Property="BorderBrush" Value="#E5CE70" />
                                <Setter Property="TextElement.Foreground" Value="#7A5900" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="discount_50">
                                <Setter Property="Background" Value="#EAF2FF" />
                                <Setter Property="BorderBrush" Value="#9FC1F5" />
                                <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Stage, Converter={StaticResource StageLabelConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,24,16,20">
                    <TextBlock Text="门店效期排查"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="库存与效期工作台"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="8,0,8,0">
                    <Button Content="首页"
                            Command="{Binding NavigateHomeCommand}"
                            Tag="{Binding IsDashboardVisible}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="待排查任务"
                            Command="{Binding NavigateTasksCommand}"
                            Tag="{Binding IsPendingTasksVisible}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="排查记录 · 后续阶段"
                            Command="{Binding NavigateHistoryCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="数据导入"
                            Command="{Binding NavigateImportCommand}"
                            Tag="{Binding IsImportVisible}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="设置 · 后续阶段"
                            Command="{Binding NavigateSettingsCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20,16,16,20">
                    <TextBlock Text="Stage 4"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="查询与数据导入"
                               FontSize="12"
                               Foreground="{DynamicResource DisabledTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding PageSubtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer x:Name="DashboardScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,24">
                            <Border Padding="12"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dashboard.IsStale}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Dashboard.HasError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Dashboard.LastImportText}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Dashboard.FreshnessWarningText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Dashboard.ErrorMessage}"
                                                   Visibility="{Binding Dashboard.HasError, Converter={StaticResource BoolToVisibility}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource WarningTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="刷新"
                                            Command="{Binding Dashboard.RefreshCommand}"
                                            Margin="12,0,0,0" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,20,0,8"
                                       Text="待排查概览"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <UniformGrid Columns="5">
                                <Border Margin="0,0,8,0"
                                        Padding="12,10"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="待排查"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Dashboard.OpenTaskCount}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,0"
                                        Padding="12,10"
                                        Background="#FDECEC"
                                        BorderBrush="#E5A3A8"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="过期" FontSize="12" Foreground="#A4262C" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Dashboard.ExpiredCount}" FontSize="20" FontWeight="SemiBold" Foreground="#A4262C" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,0"
                                        Padding="12,10"
                                        Background="#FFF0E5"
                                        BorderBrush="#F2B58B"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="收仓" FontSize="12" Foreground="#9A3412" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Dashboard.WithdrawCount}" FontSize="20" FontWeight="SemiBold" Foreground="#9A3412" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,0"
                                        Padding="12,10"
                                        Background="#FFF8D6"
                                        BorderBrush="#E5CE70"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="2折" FontSize="12" Foreground="#7A5900" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Dashboard.Discount20Count}" FontSize="20" FontWeight="SemiBold" Foreground="#7A5900" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="12,10"
                                        Background="#EAF2FF"
                                        BorderBrush="#9FC1F5"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="5折" FontSize="12" Foreground="#1D4ED8" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Dashboard.Discount50Count}" FontSize="20" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,24,0,8">
                                <TextBlock Text="最紧急任务"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <Button HorizontalAlignment="Right"
                                        Content="查看全部待排查任务"
                                        Command="{Binding Dashboard.ViewAllTasksCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0" />
                            </Grid>
                            <TextBlock Text="正在加载…"
                                       Visibility="{Binding Dashboard.IsLoading, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="暂无导入数据"
                                       Visibility="{Binding Dashboard.HasNoImportData, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="当前没有待排查任务"
                                       Visibility="{Binding Dashboard.HasNoOpenTasks, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <DataGrid x:Name="DashboardUrgentTasksDataGrid"
                                      ItemsSource="{Binding Dashboard.UrgentTasks}"
                                      AutoGenerateColumns="False"
                                      Visibility="{Binding Dashboard.HasError, Converter={StaticResource InverseBoolToVisibility}}"
                                      IsTabStop="False"
                                      Focusable="True"
                                      SelectionMode="Single"
                                      SelectionUnit="Cell"
                                      ClipboardCopyMode="ExcludeHeader"
                                      PreviewMouseWheel="DashboardDataGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="阶段" Width="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource StageBadgeTemplate}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="*" />
                                    <DataGridTextColumn Header="商品编码" Binding="{Binding ProductCode}" Width="150" />
                                    <DataGridTextColumn Header="商品条码" Binding="{Binding ProductBarcode}" Width="140" />
                                    <DataGridTextColumn Header="批次数" Binding="{Binding PendingBatchCount}" Width="80" />
                                    <DataGridTextColumn Header="库存" Binding="{Binding EffectiveStockQty}" Width="80" />
                                    <DataGridTextColumn Header="最近有效日期"
                                                         Binding="{Binding NearestExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                         Width="120" />
                                    <DataGridTemplateColumn Header="操作" Width="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="去排查"
                                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Height="32"
                                                        Padding="8,0"
                                                        Margin="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsPendingTasksVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,8,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="待排查任务"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Margin="12,4,0,0"
                                       Text="{Binding PendingTasks.TotalCount, StringFormat=共 {0} 个商品}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TaskSearchBox"
                                 Text="{Binding PendingTasks.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索商品名称、编码或条码">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding PendingTasks.SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="搜索"
                                Command="{Binding PendingTasks.SearchCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="阶段"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PendingTasks.StageFilters}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="CanonicalStage"
                                  SelectedValue="{Binding PendingTasks.SelectedStage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="3"
                                Content="清空筛选"
                                Command="{Binding PendingTasks.ClearFiltersCommand}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock Text="正在加载…"
                                   Visibility="{Binding PendingTasks.IsLoading, Converter={StaticResource BoolToVisibility}}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding PendingTasks.HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PendingTasks.ErrorMessage}"
                                       FontSize="13"
                                       Foreground="#A4262C"
                                       VerticalAlignment="Center" />
                            <Button Content="重试"
                                    Command="{Binding PendingTasks.RetryCommand}"
                                    Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="没有符合当前条件的任务"
                                   Visibility="{Binding PendingTasks.IsFilterEmpty, Converter={StaticResource BoolToVisibility}}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="当前没有待排查任务"
                                   Visibility="{Binding PendingTasks.IsDatabaseEmpty, Converter={StaticResource BoolToVisibility}}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>

                    <DataGrid Grid.Row="4"
                              ItemsSource="{Binding PendingTasks.Items}"
                              AutoGenerateColumns="False"
                              Visibility="{Binding PendingTasks.HasError, Converter={StaticResource InverseBoolToVisibility}}"
                              IsTabStop="False"
                              Focusable="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="最高阶段" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource StageBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="商品编码" Binding="{Binding ProductCode}" Width="150" />
                            <DataGridTextColumn Header="待排查批次数" Binding="{Binding PendingBatchCount}" Width="108" />
                            <DataGridTextColumn Header="库存总数" Binding="{Binding EffectiveStockQty}" Width="88" />
                            <DataGridTextColumn Header="最近有效日期"
                                                 Binding="{Binding NearestExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                 Width="120" />
                            <DataGridTemplateColumn Header="操作" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="去排查"
                                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="32"
                                                Padding="8,0"
                                                Margin="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="5" Margin="0,12,0,16">
                        <TextBlock Text="{Binding PendingTasks.PageSummary}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="上一页"
                                    Command="{Binding PendingTasks.PreviousPageCommand}"
                                    IsEnabled="{Binding PendingTasks.CanGoPrevious}"
                                    Margin="0,0,8,0" />
                            <Button Content="下一页"
                                    Command="{Binding PendingTasks.NextPageCommand}"
                                    IsEnabled="{Binding PendingTasks.CanGoNext}"
                                    Margin="0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsInspectionDetailVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,8,0,10"
                          Visibility="{Binding Detail.IsOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="返回"
                                Command="{Binding Detail.BackCommand}"
                                Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Detail.ProductName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ContentControl Content="{Binding Detail}"
                                                ContentTemplate="{StaticResource DetailStageBadgeTemplate}"
                                                Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Detail.ProductCode, StringFormat=商品编码：{0}}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Detail.ProductBarcode, StringFormat=条码：{0}}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="有效库存"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Detail.EffectiveStockQty}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="待排查批次"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Detail.PendingBatchCount}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                            <Button Content="修正库存"
                                    Command="{Binding Detail.OpenInventoryCommand}"
                                    Margin="0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Padding="12"
                            Margin="0,0,0,10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding Detail.IsInventoryEditorVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="修正为"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Detail.InventoryText, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Right"
                                     ToolTip="请输入非负整数" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Detail.InventoryError}"
                                       Foreground="#A4262C"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                            <Button Grid.Column="3"
                                    Content="取消"
                                    Command="{Binding Detail.CancelInventoryCommand}"
                                    Margin="8,0,8,0" />
                            <Button Grid.Column="4"
                                    Content="保存修正"
                                    Command="{Binding Detail.AdjustInventoryCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2"
                          Margin="0,0,0,8"
                          Visibility="{Binding Detail.IsOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="检查人"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Detail.InspectorName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding Detail.CanEdit}" />
                            <TextBlock Grid.Column="2"
                                       Text="检查日期"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="16,0,8,0" />
                            <DatePicker Grid.Column="3"
                                        SelectedDate="{Binding Detail.CheckDateValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedDateFormat="Short"
                                        IsEnabled="{Binding Detail.CanEdit}" />
                            <StackPanel Grid.Column="5"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Detail.DraftStatusText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Detail.SaveStatusText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <Button Content="重试"
                                        Command="{Binding Detail.RetrySaveCommand}"
                                        Visibility="{Binding Detail.SaveFailed, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              Background="{DynamicResource SurfaceSubtleBrush}"
                              Margin="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="生产日期" Grid.Column="0" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="有效日期" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="阶段" Grid.Column="2" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="累计到货" Grid.Column="3" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="上次排查" Grid.Column="4" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="本次件数" Grid.Column="5" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="状态 / 动作" Grid.Column="6" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Detail.TaskItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,6"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter Property="Background" Value="#EAF2FF" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding RequiresReconfirmation}" Value="True">
                                                                <Setter Property="Background" Value="#F4ECFB" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasInputError}" Value="True">
                                                                <Setter Property="Background" Value="#FDECEC" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid MinHeight="48">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="126" />
                                                        <ColumnDefinition Width="108" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding ProductionDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                               Margin="8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                               Margin="8,0"
                                                               VerticalAlignment="Center" />
                                                    <ContentControl Grid.Column="2"
                                                                    Content="{Binding}"
                                                                    ContentTemplate="{StaticResource DetailStageBadgeTemplate}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="8,0" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding CurrentArrivalQty}"
                                                               Margin="8,0"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Right" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding LastInspectionText}"
                                                               Margin="8,0"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                    <TextBox Grid.Column="5"
                                                             Text="{Binding CheckedQtyText, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="8,0"
                                                             HorizontalContentAlignment="Right"
                                                             IsEnabled="{Binding DataContext.Detail.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             ToolTip="空白=未检查；0=现场无该批次" />
                                                    <StackPanel Grid.Column="6"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="8,0">
                                                        <TextBlock Text="{Binding CheckedQtyStateText}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Text="效期阶段或到货情况已更新，请重新确认"
                                                                   Visibility="{Binding RequiresReconfirmation, Converter={StaticResource BoolToVisibility}}"
                                                                   Foreground="#6B3FA0"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />
                                                        <Button Content="重新确认"
                                                                Command="{Binding ReconfirmCommand}"
                                                                Visibility="{Binding RequiresReconfirmation, Converter={StaticResource BoolToVisibility}}"
                                                                Margin="0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Header="{Binding Detail.NormalBatchCount, StringFormat=其他正常批次（{0}）}"
                                          IsExpanded="False"
                                          Visibility="{Binding Detail.HasNormalBatches, Converter={StaticResource BoolToVisibility}}"
                                          Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding Detail.NormalBatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="36" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ProductionDate, Converter={StaticResource DateOnlyDisplayConverter}}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CurrentStage, Converter={StaticResource StageLabelConverter}}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding CurrentArrivalQty}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <TextBlock Text="{Binding Detail.ActionErrorMessage}"
                                           Visibility="{Binding Detail.HasActionError, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="#A4262C"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Detail.FeedbackMessage}"
                                           Visibility="{Binding Detail.HasFeedback, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="#16794C"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding Detail.IsTerminal, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Detail.StatusMessage}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding Detail.CloseReasonText}"
                                   Visibility="{Binding Detail.HasCloseReason, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="请返回来源页面继续操作。"
                                   Margin="0,8,0,16"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Detail.SubmissionCompletedAtText}"
                                   Visibility="{Binding Detail.HasSubmissionCompletedAt, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,0,0,12"
                                   HorizontalAlignment="Center"
                                   Foreground="#16794C" />
                        <TextBlock Text="{Binding Detail.ActionErrorMessage}"
                                   Visibility="{Binding Detail.HasActionError, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,0,0,12"
                                   HorizontalAlignment="Center"
                                   Foreground="#A4262C"
                                   TextWrapping="Wrap" />
                        <Button Content="返回"
                                Command="{Binding Detail.BackCommand}"
                                HorizontalAlignment="Center"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding Detail.HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Detail.ErrorMessage}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="#A4262C" />
                        <TextBlock Text="{Binding Detail.ActionErrorMessage}"
                                   Visibility="{Binding Detail.HasActionError, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#A4262C"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="重试"
                                    Command="{Binding Detail.RetryLoadCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="返回"
                                    Command="{Binding Detail.BackCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="正在加载…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding Detail.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Grid.Row="3"
                          Margin="0,4,0,16"
                          Visibility="{Binding Detail.ShowSubmitFooter, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Detail.SubmissionHintText}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding Detail.SubmitButtonText}"
                                    Command="{Binding Detail.SubmitCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="清空草稿"
                                    Command="{Binding Detail.ClearDraftCommand}"
                                    Margin="0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,4,0,16"
                            Padding="12"
                            Background="{DynamicResource WarningSurfaceBrush}"
                            BorderBrush="#E5CE70"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding Detail.HasOverStockConfirmation, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Detail.OverStockMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningTextBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource WarningTextBrush}">
                                    <Run Text="当前库存：" />
                                    <Run Text="{Binding Detail.OverStockEffectiveStockQty, Mode=OneWay}" />
                                    <Run Text="    排查合计：" />
                                    <Run Text="{Binding Detail.OverStockTotalCheckedQty, Mode=OneWay}" />
                                    <Run Text="    超出：" />
                                    <Run Text="{Binding Detail.OverStockExcessQty, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right">
                                <Button x:Name="ReturnFromOverStockButton"
                                        Content="返回修改排查件数"
                                        Command="{Binding Detail.ReturnFromOverStockCommand}"
                                        IsVisibleChanged="ReturnFromOverStockButton_IsVisibleChanged"
                                        Margin="0,0,8,0" />
                                <Button Content="修正库存"
                                        Command="{Binding Detail.OpenInventoryCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="确认仍然提交"
                                        Command="{Binding Detail.ConfirmOverStockCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsImportVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,24">
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="数据导入"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="选择标准 .xlsx 文件，先预览再确认"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Content="选择 Excel"
                                        Click="SelectExcel_Click"
                                        IsEnabled="{Binding Import.CanSelectFile}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0" />
                            </Grid>

                            <Border Padding="14"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Import.SelectedFileName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding Import.StatusMessage}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding Import.ErrorMessage}"
                                                   Visibility="{Binding Import.HasError, Converter={StaticResource BoolToVisibility}}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="#A4262C" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding Import.RefreshErrorMessage}"
                                                   Visibility="{Binding Import.HasRefreshError, Converter={StaticResource BoolToVisibility}}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource WarningTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="正在处理…"
                                                   Visibility="{Binding Import.IsParsing, Converter={StaticResource BoolToVisibility}}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Text="正在导入，请稍候…"
                                                   Visibility="{Binding Import.IsConfirming, Converter={StaticResource BoolToVisibility}}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,12,0" />
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="120"
                                                     Height="8"
                                                     Visibility="{Binding Import.IsConfirming, Converter={StaticResource BoolToVisibility}}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0" />
                                        <Button Content="重试"
                                                Command="{Binding Import.RetryCommand}"
                                                Visibility="{Binding Import.CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                Margin="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,0"
                                  Visibility="{Binding Import.HasPreview, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="4">
                                    <Border Margin="0,0,8,8"
                                            Padding="12,10"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="涉及商品"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding Import.InvolvedProductCount}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,8,8"
                                            Padding="12,10"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="正常批次键"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding Import.NormalBatchKeyCount}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,8,8"
                                            Padding="12,10"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="新增 / 更新商品"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Import.NewProductCount}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text=" / "
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="{Binding Import.UpdatedProductCount}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,0,8"
                                            Padding="12,10"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="新增 / 更新批次"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Import.NewBatchCount}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text=" / "
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="{Binding Import.UpdatedBatchCount}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="1" Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="行与规划问题均按既有 Application 结果展示"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Import.ChangeStatusText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Margin="12,0,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="确认导入"
                                            Command="{Binding Import.ConfirmCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0" />
                                </Grid>

                                <UniformGrid Grid.Row="2" Columns="6">
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="跳过行" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.SkippedRowCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="行问题" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.RowIssueCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="重复行" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.DuplicateRowCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="批次冲突" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.BatchConflictCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="库存冲突" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.StockConflictCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Padding="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel><TextBlock Text="规划问题" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Import.PlanningIssueCount}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>

                            <TextBlock Margin="0,16,0,8"
                                       Text="异常与警告明细"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Visibility="{Binding Import.HasWarningDetails, Converter={StaticResource BoolToVisibility}}" />
                            <Expander Header="行问题"
                                      IsExpanded="True"
                                      Visibility="{Binding Import.HasRowIssues, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.RowIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding ExcelRowNumber, StringFormat=第 {0} 行}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding FieldName, StringFormat=字段：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding Summary}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="跳过行"
                                      IsExpanded="False"
                                      Visibility="{Binding Import.HasSkippedRows, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.SkippedRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding ExcelRowNumber, StringFormat=第 {0} 行}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding OriginalProductCategory, StringFormat=商品大类：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="重复行"
                                      IsExpanded="False"
                                      Visibility="{Binding Import.HasDuplicateRows, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.DuplicateRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                                <TextBlock Text="{Binding DuplicateRowNumber, StringFormat=第 {0} 行与第 }"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding RepresentativeRowNumber, StringFormat={}{0} 行重复}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="规划问题"
                                      IsExpanded="True"
                                      Visibility="{Binding Import.HasPlanningIssues, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.PlanningIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding ProductCode, StringFormat=商品编码：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding ExcelRowNumber, StringFormat=行号：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding FieldName, StringFormat=字段：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding SafeSummary}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="批次冲突"
                                      IsExpanded="False"
                                      Visibility="{Binding Import.HasBatchConflicts, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Import.Preview.BatchConflicts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding BatchKey.ProductCode, StringFormat=商品编码：{0}}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <ItemsControl ItemsSource="{Binding DifferingFields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat=差异字段：{0}}"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="库存冲突"
                                      IsExpanded="False"
                                      Visibility="{Binding Import.HasStockConflicts, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Import.Preview.StockConflicts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3">
                                                <TextBlock Text="{Binding ProductCode, StringFormat=商品编码：{0}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <ItemsControl ItemsSource="{Binding Values}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Value, StringFormat=库存值：{0}；行号：}"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                <ItemsControl ItemsSource="{Binding RowNumbers}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding StringFormat={}{0} }"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
