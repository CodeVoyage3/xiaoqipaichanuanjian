<Window x:Class="StoreExpiryInspector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StoreExpiryInspector.UI"
        Title="门店效期排查软件"
        Width="1280"
        Height="760"
        MinWidth="1024"
        MinHeight="600"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Language="zh-CN"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="Window_SizeChanged">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Window.Resources>
        <ui:StageLabelConverter x:Key="StageLabelConverter" />
        <ui:DateOnlyDisplayConverter x:Key="DateOnlyDisplayConverter" />
        <ui:UtcDateTimeDisplayConverter x:Key="UtcDateTimeDisplayConverter" />
        <ui:Stage4BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:Stage4InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <ui:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        <ui:HumanReadableFileSizeConverter x:Key="HumanReadableFileSizeConverter" />

        <Style x:Key="DraftFooterStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Detail.HasRecoveredDraft}" Value="True" />
                        <Condition Binding="{Binding Detail.HasUnsavedChanges}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Detail.IsSaving}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Detail.SaveFailed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StageBadgeTemplate">
            <Border Padding="8,2"
                    Height="26"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                        <Setter Property="TextElement.Foreground" Value="#475569" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HighestStage}" Value="expired">
                                <Setter Property="Background" Value="#FDECEC" />
                                <Setter Property="BorderBrush" Value="#E5A3A8" />
                                <Setter Property="TextElement.Foreground" Value="#A4262C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="withdraw">
                                <Setter Property="Background" Value="#FFF0E5" />
                                <Setter Property="BorderBrush" Value="#F2B58B" />
                                <Setter Property="TextElement.Foreground" Value="#9A3412" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="discount_20">
                                <Setter Property="Background" Value="#FFF8D6" />
                                <Setter Property="BorderBrush" Value="#E5CE70" />
                                <Setter Property="TextElement.Foreground" Value="#7A5900" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="discount_50">
                                <Setter Property="Background" Value="#EAF2FF" />
                                <Setter Property="BorderBrush" Value="#9FC1F5" />
                                <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding HighestStage, Converter={StaticResource StageLabelConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DetailStageBadgeTemplate">
            <Border Padding="8,2"
                    Height="26"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                        <Setter Property="TextElement.Foreground" Value="#475569" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="expired">
                                <Setter Property="Background" Value="#FDECEC" />
                                <Setter Property="BorderBrush" Value="#E5A3A8" />
                                <Setter Property="TextElement.Foreground" Value="#A4262C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="withdraw">
                                <Setter Property="Background" Value="#FFF0E5" />
                                <Setter Property="BorderBrush" Value="#F2B58B" />
                                <Setter Property="TextElement.Foreground" Value="#9A3412" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="discount_20">
                                <Setter Property="Background" Value="#FFF8D6" />
                                <Setter Property="BorderBrush" Value="#E5CE70" />
                                <Setter Property="TextElement.Foreground" Value="#7A5900" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="discount_50">
                                <Setter Property="Background" Value="#EAF2FF" />
                                <Setter Property="BorderBrush" Value="#9FC1F5" />
                                <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Stage, Converter={StaticResource StageLabelConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HistoryStageBadgeTemplate">
            <Border Padding="8,2"
                    Height="26"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                        <Setter Property="TextElement.Foreground" Value="#475569" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="expired">
                                <Setter Property="Background" Value="#FDECEC" />
                                <Setter Property="BorderBrush" Value="#E5A3A8" />
                                <Setter Property="TextElement.Foreground" Value="#A4262C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="withdraw">
                                <Setter Property="Background" Value="#FFF0E5" />
                                <Setter Property="BorderBrush" Value="#F2B58B" />
                                <Setter Property="TextElement.Foreground" Value="#9A3412" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="discount_20">
                                <Setter Property="Background" Value="#FFF8D6" />
                                <Setter Property="BorderBrush" Value="#E5CE70" />
                                <Setter Property="TextElement.Foreground" Value="#7A5900" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="discount_50">
                                <Setter Property="Background" Value="#EAF2FF" />
                                <Setter Property="BorderBrush" Value="#9FC1F5" />
                                <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="none">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="TextElement.Foreground" Value="#475569" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StageSnapshot, Converter={StaticResource StageLabelConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <Style x:Key="HistoryCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- UIUX-R02: keyed styles keep the three representative pages dense without
             changing the existing shared styles used by the other pages. -->
        <Style x:Key="PageTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectionInspectorNameTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource PageTextBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Detail.HasInspectorNameError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadOnlyIdentityTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource PageTextBoxStyle}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>

        <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PendingProductNameTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource TableCellTextStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="TableNumericTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource TableCellTextStyle}">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableCenterColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableNumericCenterTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource TableNumericTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableCenterTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource TableCellTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PendingDataGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PendingTasks.IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PendingTasks.HasError}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PendingTasks.HasEmptyResult}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardDataGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource {x:Type DataGrid}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dashboard.IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dashboard.HasError}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dashboard.HasNoImportData}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dashboard.HasNoOpenTasks}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dashboard.HasNoSearchResults}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InspectionStatusTagStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasCheckedQty}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasInputError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RequiresReconfirmation}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ReconfirmSurfaceBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InspectionStatusTagTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding CheckedQtyStateText, Mode=OneWay}" />
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasCheckedQty}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasInputError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RequiresReconfirmation}" Value="True">
                    <Setter Property="Text" Value="需要重新确认" />
                    <Setter Property="Foreground" Value="{DynamicResource ReconfirmBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- UIUX-R03: remaining pages use one restrained work-surface language. -->
        <Style x:Key="PageSectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="ImportAvailabilityTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="{Binding Import.CanConfirm, Converter={StaticResource InverseBoolToVisibility}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Import.IsSucceeded}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateMessageBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource PageSectionBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="MinHeight" Value="112" />
        </Style>

        <Style x:Key="HistoryListDataGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource {x:Type DataGrid}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding History.IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding History.HasError}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding History.HasEmptyResult}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryListSurfaceStyle"
               TargetType="Border"
               BasedOn="{StaticResource PageSectionBorderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding History.IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding History.HasError}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding History.HasEmptyResult}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BackupListDataGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource {x:Type DataGrid}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BackupRestore.IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackupRestore.HasError}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackupRestore.HasNoBackups}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackupRestore.IsLocked}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BackupListSurfaceStyle"
               TargetType="Border"
               BasedOn="{StaticResource PageSectionBorderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BackupRestore.IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackupRestore.HasError}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackupRestore.HasNoBackups}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackupRestore.IsLocked}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellRoot"
          MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                    <Grid x:Name="NavigationBrandArea" Margin="12,20,12,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NavigationToggleButton"
                            Content="‹"
                            Click="ToggleNavigation_Click"
                            Style="{StaticResource LinkButtonStyle}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            ToolTip="收起导航"
                            AutomationProperties.Name="收起或展开导航" />
                    <Border Grid.Column="1"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource PrimaryActionBrush}"
                            CornerRadius="7"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource ShieldIcon}"
                              Fill="White"
                              Stretch="Uniform"
                              Margin="7" />
                    </Border>
                    <TextBlock x:Name="NavigationBrandText"
                               Grid.Column="2"
                               Margin="8,0,0,0"
                               Text="门店效期排查软件"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="12,0,12,0">
                    <Button x:Name="NavigationHomeButton"
                            AutomationProperties.Name="首页"
                            ToolTip="首页"
                            Command="{Binding NavigateHomeCommand}"
                            Tag="{Binding IsDashboardVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource HomeIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock x:Name="NavigationHomeText" Text="首页" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavigationTasksButton"
                            AutomationProperties.Name="待排查任务"
                            ToolTip="待排查任务"
                            Command="{Binding NavigateTasksCommand}"
                            Tag="{Binding IsPendingTasksVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ClipboardIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock x:Name="NavigationTasksText" Text="待排查任务" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavigationHistoryButton"
                            AutomationProperties.Name="排查历史"
                            ToolTip="排查历史"
                            Command="{Binding NavigateHistoryCommand}"
                            Tag="{Binding IsHistoryVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FileIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock x:Name="NavigationHistoryText" Text="排查历史" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavigationImportButton"
                            AutomationProperties.Name="数据导入"
                            ToolTip="数据导入"
                            Command="{Binding NavigateImportCommand}"
                            Tag="{Binding IsImportVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ImportIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock x:Name="NavigationImportText" Text="数据导入" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavigationBackupButton"
                            AutomationProperties.Name="数据备份与恢复"
                            ToolTip="数据备份与恢复"
                            Command="{Binding NavigateBackupRestoreCommand}"
                            Tag="{Binding IsBackupRestoreVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ShieldIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock x:Name="NavigationBackupText" Text="数据备份与恢复" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavigationSettingsButton"
                            AutomationProperties.Name="设置"
                            ToolTip="提醒时间与开机自启动"
                            Click="Settings_Click"
                            IsEnabled="{Binding CanOpenSettings}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GearIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock x:Name="NavigationSettingsText" Text="设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="20,16,16,20">
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,0,0,12" />
                    <TextBlock x:Name="NavigationVersionText"
                               Text="软件版本：v1.0.0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentRoot"
              Grid.Row="0"
              Grid.Column="1"
              Margin="24,0,24,0"
              MinHeight="0"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Visibility="{Binding IsInspectionDetailVisible, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Height" Value="72" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDashboardVisible}" Value="True">
                                <Setter Property="Height" Value="72" />
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPendingTasksVisible}" Value="True">
                                <Setter Property="Height" Value="72" />
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding PageSubtitle}"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="0"
                  Height="72"
                  Margin="0"
                  Visibility="{Binding IsInspectionDetailVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding PageSubtitle}"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="返回待排查任务"
                        Command="{Binding Detail.BackCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="返回待排查任务"
                        Width="132"
                        VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="ContentPageRoot"
                  Grid.Row="1"
                  MinHeight="0"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 首页 -->
                <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer x:Name="DashboardScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <Border Padding="12,0"
                                    Height="42"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource SearchIcon}"
                                          Width="18"
                                          Height="18"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="1.6"
                                          Fill="Transparent"
                                          VerticalAlignment="Center" />
                                    <TextBox x:Name="HomeSearchBox"
                                             Grid.Column="1"
                                             Height="40"
                                             BorderThickness="0"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="搜索商品名称、商品条码或商品编码"
                                             Text="{Binding PendingTasks.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="搜索商品名称、商品条码或商品编码">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchTasksCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="2"
                                            Content="搜索"
                                            Command="{Binding SearchTasksCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="72"
                                            Height="32"
                                            Padding="8,0"
                                            Margin="8,0,4,0"
                                            ToolTip="搜索"
                                            AutomationProperties.Name="搜索"
                                            />
                                    <Button Grid.Column="3"
                                            Content="×"
                                            Command="{Binding ClearDashboardSearchCommand}"
                                            Style="{StaticResource LinkButtonStyle}"
                                            FontSize="18"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            ToolTip="清空首页搜索"
                                            AutomationProperties.Name="清空首页搜索"
                                            Visibility="{Binding PendingTasks.HasSearchText, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="1"
                                               Text="搜索商品名称 / 商品条码 / 商品编码"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Foreground="#8995AA"
                                               FontSize="14"
                                               Visibility="{Binding PendingTasks.SearchText, Converter={StaticResource EmptyStringToVisibility}}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,8,0,0"
                                    Padding="10,0"
                                    Height="52"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dashboard.IsStale}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Dashboard.HasError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="2,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboard.IsStale}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Dashboard.HasError}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="数据正常" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboard.IsStale}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Dashboard.FreshnessWarningText}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Dashboard.HasNoImportData}" Value="True">
                                                            <Setter Property="Text" Value="暂无导入数据" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Dashboard.HasError}" Value="True">
                                                            <Setter Property="Text" Value="数据读取失败" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="待排查 " FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Dashboard.OpenTaskCount}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryActionBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Height="28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="过期 " FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Dashboard.ExpiredCount}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Height="28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="收仓 " FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Dashboard.WithdrawCount}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="4" Height="28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="2折 " FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Dashboard.Discount20Count}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="5" Height="28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="5折 " FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Dashboard.Discount50Count}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="6" Height="28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding Dashboard.LastImportText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Dashboard.LastImportText}" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="优先处理" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="按紧急程度和最近有效期排序"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,2,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Content="查看全部待排查任务  →"
                                        Command="{Binding Dashboard.ViewAllTasksCommand}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Margin="0" />
                            </Grid>
                            <TextBlock Text="正在加载首页数据…"
                                       Visibility="{Binding Dashboard.IsLoading, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="暂无导入数据，请先导入最新的食品效期 Excel。"
                                       Visibility="{Binding Dashboard.HasNoImportData, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="当前没有待排查任务。"
                                       Visibility="{Binding Dashboard.HasNoOpenTasks, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{Binding Dashboard.SearchResultText}"
                                       Visibility="{Binding Dashboard.IsSearchActive, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="没有找到符合条件的待排查商品。"
                                       Visibility="{Binding Dashboard.HasNoSearchResults, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <StackPanel Visibility="{Binding Dashboard.HasError, Converter={StaticResource BoolToVisibility}}"
                                         Margin="0,0,0,8">
                                <TextBlock Text="首页数据加载失败"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="{Binding Dashboard.ErrorMessage}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Margin="0,4,0,0" />
                                <Button Content="重试"
                                        Command="{Binding Dashboard.RefreshCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="88"
                                        Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding Dashboard.HasError, Converter={StaticResource InverseBoolToVisibility}}">
                                <DataGrid x:Name="DashboardUrgentTasksDataGrid"
                                          Style="{StaticResource DashboardDataGridStyle}"
                                          ItemsSource="{Binding Dashboard.UrgentTasks}"
                                          AutoGenerateColumns="False"
                                          IsTabStop="True"
                                          Focusable="True"
                                          SelectionMode="Single"
                                          SelectionUnit="Cell"
                                          ClipboardCopyMode="ExcludeHeader"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          PreviewMouseWheel="DashboardDataGrid_PreviewMouseWheel">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="阶段" Width="82">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StageBadgeTemplate}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="*" ElementStyle="{StaticResource TableCellTextStyle}" />
                                        <DataGridTextColumn Header="商品条码" Binding="{Binding ProductBarcode}" Width="150" ElementStyle="{StaticResource TableCellTextStyle}" />
                                        <DataGridTextColumn Header="商品编码" Binding="{Binding ProductCode}" Width="150" ElementStyle="{StaticResource TableCellTextStyle}" />
                                        <DataGridTextColumn Header="库存"
                                                             HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                             Binding="{Binding EffectiveStockQty}"
                                                             Width="72"
                                                             ElementStyle="{StaticResource TableNumericCenterTextStyle}" />
                                        <DataGridTextColumn Header="最近有效期"
                                                             HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                             Binding="{Binding NearestExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                             Width="124"
                                                             ElementStyle="{StaticResource TableNumericCenterTextStyle}" />
                                        <DataGridTemplateColumn Header="操作"
                                                                HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                                Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="排查  →"
                                                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            Height="32"
                                                            Padding="4,0"
                                                            Margin="0"
                                                            HorizontalAlignment="Center"
                                                            AutomationProperties.Name="排查此商品" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 待排查任务 -->
                <Grid Visibility="{Binding IsPendingTasksVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="TaskSearchBox"
                                     Style="{StaticResource PageTextBoxStyle}"
                                     Height="42"
                                     Padding="42,4,36,4"
                                     AutomationProperties.Name="搜索商品名称、商品条码或商品编码"
                                     Text="{Binding PendingTasks.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="搜索商品名称、商品条码或商品编码">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding PendingTasks.SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Path Data="{StaticResource SearchIcon}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  HorizontalAlignment="Left"
                                  Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                            <TextBlock Text="搜索商品名称 / 商品条码 / 商品编码"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="42,0,36,0"
                                       Foreground="#8995AA"
                                       FontSize="14"
                                       Visibility="{Binding PendingTasks.SearchText, Converter={StaticResource EmptyStringToVisibility}}" />
                            <Button Content="×"
                                    Command="{Binding PendingTasks.ClearFiltersCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    FontSize="18"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    ToolTip="清空搜索和阶段筛选"
                                    AutomationProperties.Name="清空搜索和阶段筛选"
                                    Visibility="{Binding PendingTasks.IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <Button Grid.Column="1"
                                    Content="搜索"
                                    Command="{Binding PendingTasks.SearchCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="72"
                                    Height="42"
                                    Padding="8,0"
                                    Margin="8,0,0,0"
                                    ToolTip="搜索"
                                    AutomationProperties.Name="搜索"
                                    />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <ListBox ItemsSource="{Binding PendingTasks.StageFilters}"
                                 SelectedValuePath="CanonicalStage"
                                 SelectedIndex="0"
                                 SelectedValue="{Binding PendingTasks.SelectedStage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Left"
                                 Margin="0,0,24,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <Border Background="#F1F5F9"
                                                CornerRadius="8"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                MinWidth="24">
                                            <TextBlock x:Name="StageCountText"
                                                       Text="0"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="{x:Null}">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.OpenTaskCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="expired">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.ExpiredCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="withdraw">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.WithdrawCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="discount_20">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.Discount20Count, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="discount_50">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.Discount50Count, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding PendingTasks.TotalCount, StringFormat=共 {0} 个商品}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="默认按紧急程度和最近有效期排序"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="正在加载…"
                                       Visibility="{Binding PendingTasks.IsLoading, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="清空筛选"
                                    Command="{Binding PendingTasks.ClearFiltersCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Margin="12,0,0,0" />
                            <Button Content="刷新"
                                    Command="{Binding PendingTasks.RetryCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.Name="刷新待排查任务"
                                    Width="72"
                                    Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Border x:Name="PendingTasksStandardGrid"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <DataGrid ItemsSource="{Binding PendingTasks.Items}"
                                      Style="{StaticResource PendingDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="Cell"
                                      ClipboardCopyMode="ExcludeHeader"
                                      BorderThickness="0"
                                      IsTabStop="True"
                                      Focusable="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="阶段" Width="78">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StageBadgeTemplate}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="*" ElementStyle="{StaticResource PendingProductNameTextStyle}" />
                                    <DataGridTextColumn Header="商品条码" Binding="{Binding ProductBarcode}" Width="142" ElementStyle="{StaticResource TableCellTextStyle}" />
                                    <DataGridTextColumn Header="商品编码" Binding="{Binding ProductCode}" Width="142" ElementStyle="{StaticResource TableCellTextStyle}" />
                                    <DataGridTextColumn Header="批次数"
                                                         Binding="{Binding PendingBatchCount}"
                                                         Width="76"
                                                         ElementStyle="{StaticResource TableNumericTextStyle}" />
                                    <DataGridTextColumn Header="库存"
                                                         HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                         Binding="{Binding EffectiveStockQty}"
                                                         Width="68"
                                                         ElementStyle="{StaticResource TableNumericCenterTextStyle}" />
                                    <DataGridTextColumn Header="最近有效期"
                                                         HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                         Binding="{Binding NearestExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                         Width="118"
                                                         ElementStyle="{StaticResource TableNumericCenterTextStyle}" />
                                    <DataGridTemplateColumn Header="操作"
                                                            HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                            Width="94">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="排查  →"
                                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                         Style="{StaticResource LinkButtonStyle}"
                                                         Height="34"
                                                         Padding="4,0"
                                                         Margin="0"
                                                         HorizontalAlignment="Center"
                                                         AutomationProperties.Name="排查此商品" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border x:Name="PendingTasksCompactGrid"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <DataGrid ItemsSource="{Binding PendingTasks.Items}"
                                      Style="{StaticResource PendingDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="Cell"
                                      ClipboardCopyMode="ExcludeHeader"
                                      BorderThickness="0"
                                      IsTabStop="True"
                                      Focusable="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="阶段" Width="78">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource StageBadgeTemplate}"
                                                                HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="商品身份（名称 / 条码 / 编码，可复制）" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2" VerticalAlignment="Center">
                                                    <TextBox Text="{Binding ProductName, Mode=OneWay}"
                                                             Style="{StaticResource ReadOnlyIdentityTextBoxStyle}"
                                                             Height="18"
                                                             FontSize="13"
                                                             FontWeight="SemiBold"
                                                             ToolTip="{Binding ProductName}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="条码 "
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Text="{Binding ProductBarcode, Mode=OneWay}"
                                                                 Style="{StaticResource ReadOnlyIdentityTextBoxStyle}"
                                                                 Height="18"
                                                                 Width="124"
                                                                 FontSize="12"
                                                                 ToolTip="{Binding ProductBarcode}" />
                                                        <TextBlock Text="  编码 "
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Text="{Binding ProductCode, Mode=OneWay}"
                                                                 Style="{StaticResource ReadOnlyIdentityTextBoxStyle}"
                                                                 Height="18"
                                                                 Width="124"
                                                                 FontSize="12"
                                                                 ToolTip="{Binding ProductCode}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="批次"
                                                         Binding="{Binding PendingBatchCount}"
                                                         Width="70"
                                                         ElementStyle="{StaticResource TableNumericTextStyle}" />
                                    <DataGridTextColumn Header="库存"
                                                         HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                         Binding="{Binding EffectiveStockQty}"
                                                         Width="68"
                                                         ElementStyle="{StaticResource TableNumericCenterTextStyle}" />
                                    <DataGridTextColumn Header="最近有效期"
                                                         HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                         Binding="{Binding NearestExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                         Width="118"
                                                         ElementStyle="{StaticResource TableNumericCenterTextStyle}" />
                                    <DataGridTemplateColumn Header="操作"
                                                            HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                            Width="94">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="排查  →"
                                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource LinkButtonStyle}"
                                                        Height="34"
                                                        Padding="4,0"
                                                        Margin="0"
                                                        HorizontalAlignment="Center"
                                                        AutomationProperties.Name="排查此商品" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding PendingTasks.HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="待排查任务加载失败"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       Foreground="#A4262C" />
                            <TextBlock Text="{Binding PendingTasks.ErrorMessage}"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Button Content="重试"
                                    Command="{Binding PendingTasks.RetryCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="88"
                                    Margin="0,16,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding PendingTasks.HasEmptyResult, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="没有符合当前条件的任务"
                                       Visibility="{Binding PendingTasks.IsFilterEmpty, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="当前没有待排查任务"
                                       Visibility="{Binding PendingTasks.IsDatabaseEmpty, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <Button Content="清空筛选"
                                    Command="{Binding PendingTasks.ClearFiltersCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Visibility="{Binding PendingTasks.IsFilterEmpty, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,12,0,16">
                        <TextBlock Text="{Binding PendingTasks.PageSummary}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="‹  上一页"
                                    Command="{Binding PendingTasks.PreviousPageCommand}"
                                    IsEnabled="{Binding PendingTasks.CanGoPrevious}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="112" />
                            <TextBlock Text="{Binding PendingTasks.CurrentPage}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="16,0,4,0" />
                            <TextBlock Text="/" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PendingTasks.TotalPages}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="4,0,16,0" />
                            <Button Content="下一页  ›"
                                    Command="{Binding PendingTasks.NextPageCommand}"
                                    IsEnabled="{Binding PendingTasks.CanGoNext}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="112" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 排查历史 -->
                <Grid Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.Resources>
                        <Style x:Key="HistoryNumberTextStyle"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource HistoryCellTextStyle}">
                            <Setter Property="FontFamily" Value="Segoe UI" />
                        </Style>
                        <Style x:Key="HistoryColumnHeaderStyle"
                               TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Left"
                                                   ToolTip="{Binding}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid Visibility="{Binding History.IsDetailVisible, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="正式排查记录"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="仅显示已完成的正式排查；数据来自历史快照"
                                           Margin="0,4,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Content="刷新"
                                    Command="{Binding History.RefreshCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="88"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="刷新排查历史" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Border Style="{StaticResource HistoryListSurfaceStyle}">
                                <DataGrid ItemsSource="{Binding History.Items}"
                                          Style="{StaticResource HistoryListDataGridStyle}"
                                          AutoGenerateColumns="False"
                                          ColumnWidth="Auto"
                                          ColumnHeaderStyle="{StaticResource HistoryColumnHeaderStyle}"
                                          SelectionMode="Single"
                                          SelectionUnit="Cell"
                                          ClipboardCopyMode="ExcludeHeader"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          IsTabStop="True"
                                          Focusable="True"
                                          AutomationProperties.Name="正式排查历史列表"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="商品名称"
                                                             Binding="{Binding ProductName, TargetNullValue=—}"
                                                             Width="*"
                                                             MinWidth="140"
                                                             ElementStyle="{StaticResource HistoryCellTextStyle}" />
                                        <DataGridTextColumn Header="商品条码"
                                                             Binding="{Binding ProductBarcode, TargetNullValue=—}"
                                                             Width="Auto"
                                                             MinWidth="138"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="商品编码"
                                                             Binding="{Binding ProductCode}"
                                                             Width="Auto"
                                                             MinWidth="126"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="正式排查时间"
                                                             Binding="{Binding SubmittedAtUtc, Converter={StaticResource UtcDateTimeDisplayConverter}}"
                                                             Width="Auto"
                                                             MinWidth="155"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                         <DataGridTextColumn Header="批次数"
                                                             Binding="{Binding ItemCount}"
                                                             Width="Auto"
                                                             MinWidth="78"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTemplateColumn Header="操作" Width="Auto" MinWidth="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="查看详情"
                                                            Command="{Binding DataContext.History.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            Height="32"
                                                            Padding="4,0"
                                                            Margin="12,0"
                                                            AutomationProperties.Name="查看排查历史详情" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border Style="{StaticResource StateMessageBorderStyle}"
                                    Visibility="{Binding History.IsLoading, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="正在加载排查历史…"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="请稍候，历史快照仍在读取。"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StateMessageBorderStyle}"
                                    Background="{DynamicResource ErrorSurfaceBrush}"
                                    Visibility="{Binding History.HasError, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="排查历史加载失败"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="{Binding History.ErrorMessage}"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Content="重试"
                                            Command="{Binding History.RetryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="88"
                                            Margin="0,12,0,0"
                                            AutomationProperties.Name="重试加载排查历史" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StateMessageBorderStyle}"
                                    Visibility="{Binding History.HasEmptyResult, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="暂无正式排查记录"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="完成一次正式排查后，记录会以只读历史快照显示。"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Content="刷新"
                                            Command="{Binding History.RefreshCommand}"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="刷新排查历史" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding History.IsDetailVisible, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid MinHeight="520">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="240" MinHeight="180" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="←  返回排查历史"
                                    Command="{Binding History.BackCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="返回排查历史列表" />
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        MaxWidth="360">
                                <TextBlock Text="正式排查详情"
                                           HorizontalAlignment="Right"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="正在保存…"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Visibility="{Binding History.IsEditSubmitting, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding History.EditErrorMessage}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Visibility="{Binding History.HasEditError, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding History.EditFeedbackMessage}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Visibility="{Binding History.HasEditFeedback, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource PageSectionBorderStyle}"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding History.HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="商品名称" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding History.Detail.ProductNameSnapshot, TargetNullValue=—}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding History.Detail.ProductNameSnapshot}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="商品条码" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                                    <TextBox Text="{Binding History.Detail.BarcodeSnapshot, Mode=OneWay, TargetNullValue=—}"
                                             IsReadOnly="True"
                                             IsTabStop="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             Height="24"
                                             FontSize="13"
                                             TextWrapping="Wrap"
                                             FontFamily="Segoe UI"
                                             ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                             Margin="0,2,0,0"
                                             AutomationProperties.Name="历史商品条码，可复制" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="商品编码" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBox Text="{Binding History.Detail.ProductCodeSnapshot, Mode=OneWay}"
                                             IsReadOnly="True"
                                             IsTabStop="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             Height="24"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             TextWrapping="Wrap"
                                             FontFamily="Segoe UI"
                                             ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                             Margin="0,2,0,0"
                                             AutomationProperties.Name="历史商品编码，可复制" />
                                    <TextBlock Text="正式排查时间" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding History.Detail.SubmittedAtUtc, Converter={StaticResource UtcDateTimeDisplayConverter}}"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Text="排查时阶段" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding History.Detail.StageSnapshot, Converter={StaticResource StageLabelConverter}}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="提交库存快照" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding History.Detail.StockQtySnapshot}"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="检查人" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding History.Detail.InspectorName, TargetNullValue=—}"
                                               FontSize="14"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="检查日期" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding History.Detail.CheckDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Border Style="{StaticResource PageSectionBorderStyle}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding History.HasDetail, Converter={StaticResource BoolToVisibility}}">
                                    <DataGrid ItemsSource="{Binding History.DisplayDetailItems}"
                                              SelectedValuePath="Item"
                                              SelectedValue="{Binding History.SelectedDetailItem, Mode=TwoWay}"
                                          IsEnabled="{Binding History.CanChangeHistorySelection}"
                                          AutoGenerateColumns="False"
                                          ColumnWidth="Auto"
                                          ColumnHeaderStyle="{StaticResource HistoryColumnHeaderStyle}"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          ClipboardCopyMode="ExcludeHeader"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              IsTabStop="True"
                                              Focusable="True"
                                              AutomationProperties.Name="正式排查批次快照列表"
                                              BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="批次"
                                                             HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                             Binding="{Binding DisplayBatchNumber}"
                                                             Width="Auto"
                                                             MinWidth="76"
                                                             ElementStyle="{StaticResource TableNumericCenterTextStyle}" />
                                        <DataGridTextColumn Header="生产日期"
                                                             Binding="{Binding Item.ProductionDateSnapshot, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                             Width="Auto"
                                                             MinWidth="84"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="有效日期"
                                                             Binding="{Binding Item.ExpiryDateSnapshot, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                             Width="Auto"
                                                             MinWidth="84"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTemplateColumn Header="阶段" Width="Auto" MinWidth="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding Item}"
                                                                    ContentTemplate="{StaticResource HistoryStageBadgeTemplate}"
                                                                    Margin="12,0"
                                                                    VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="累计到货"
                                                             HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                             Binding="{Binding Item.ArrivalQtySnapshot}"
                                                             Width="Auto"
                                                             MinWidth="80"
                                                             ElementStyle="{StaticResource TableNumericCenterTextStyle}" />
                                        <DataGridTextColumn Header="正式排查数量"
                                                             HeaderStyle="{StaticResource TableCenterColumnHeaderStyle}"
                                                             Binding="{Binding Item.CheckedQty}"
                                                             Width="Auto"
                                                             MinWidth="102"
                                                             ElementStyle="{StaticResource TableNumericCenterTextStyle}" />
                                        <DataGridTextColumn Header="更新时间"
                                                             Binding="{Binding Item.UpdatedAtUtc, Converter={StaticResource UtcDateTimeDisplayConverter}}"
                                                             Width="Auto"
                                                             MinWidth="155"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding History.IsDetailLoading, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="正在加载正式排查详情…"
                                           FontSize="15"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding History.HasDetailError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="排查详情加载失败"
                                           FontSize="16"
                                           Foreground="{DynamicResource DangerBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding History.DetailErrorMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Content="重试"
                                            Command="{Binding History.RetryDetailCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="88" />
                                    <Button Content="返回列表"
                                            Command="{Binding History.BackCommand}"
                                            Margin="8,0,0,0"
                                            Width="88" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding History.IsDetailNotFound, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="该正式排查记录不存在或已不可访问"
                                           FontSize="15"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <Button Content="返回列表"
                                        Command="{Binding History.BackCommand}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                Style="{StaticResource PageSectionBorderStyle}"
                                Margin="0,12,0,0"
                                Padding="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding History.HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="修改历史" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="选择批次后查看前值 → 后值 → 时间"
                                                   FontSize="12"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Margin="12,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding History.SelectedDetailBatchNumber, StringFormat=批次 {0}}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Visibility="{Binding History.HasSelectedDetailItem, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="修改数量"
                                                Command="{Binding History.BeginEditCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="32"
                                                Margin="12,0,0,0"
                                                AutomationProperties.Name="修改选中批次数量" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Padding="10"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding History.IsEditing, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="修改正式排查数量"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding History.SelectedDetailBatchNumber, StringFormat=正在修改：批次 {0}}"
                                                       Margin="0,6,0,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryActionBrush}"
                                                       Visibility="{Binding History.HasSelectedDetailItem, Converter={StaticResource BoolToVisibility}}"
                                                       AutomationProperties.Name="当前正在修改的批次" />
                                            <Grid Margin="0,6,0,0"
                                                  Visibility="{Binding History.HasSelectedDetailItem, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="生产日期：" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding History.SelectedDetailItem.ProductionDateSnapshot, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                           Margin="4,0,16,0"
                                                           FontFamily="Segoe UI" />
                                                <TextBlock Grid.Column="2" Text="有效日期：" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding History.SelectedDetailItem.ExpiryDateSnapshot, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                           Margin="4,0,16,0"
                                                           FontFamily="Segoe UI" />
                                                <TextBlock Grid.Column="4" Text="当前数量：" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding History.SelectedDetailItem.CheckedQty}"
                                                           Margin="4,0,0,0"
                                                           FontFamily="Segoe UI"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <TextBlock Text="仅修改数量，商品身份与其他历史快照保持不变"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding History.EditValidationMessage}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding History.HasEditInputError, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                             <TextBlock Text="正式数量"
                                                        TextWrapping="Wrap"
                                                        VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBox Text="{Binding History.EditCheckedQtyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="96"
                                                     Height="36"
                                                     Padding="8,0"
                                                     VerticalContentAlignment="Center"
                                                     HorizontalContentAlignment="Right"
                                                     FontFamily="Segoe UI"
                                                     IsReadOnly="{Binding History.IsEditSubmitting}"
                                                     AutomationProperties.Name="新的正式排查数量" />
                                            <Button Content="保存修改"
                                                    Command="{Binding History.SaveEditCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Height="36"
                                                    Margin="8,0,0,0"
                                                    AutomationProperties.Name="确认保存数量修改" />
                                            <Button Content="取消"
                                                    Command="{Binding History.CancelEditCommand}"
                                                    Style="{StaticResource LinkButtonStyle}"
                                                    Height="36"
                                                    Margin="8,0,0,0"
                                                    AutomationProperties.Name="取消数量修改" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" MinHeight="44">
                                    <DataGrid ItemsSource="{Binding History.Revisions}"
                                              AutoGenerateColumns="False"
                                              ColumnWidth="Auto"
                                              ColumnHeaderStyle="{StaticResource HistoryColumnHeaderStyle}"
                                              SelectionMode="Single"
                                              SelectionUnit="Cell"
                                              ClipboardCopyMode="ExcludeHeader"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              Height="120"
                                              BorderThickness="0"
                                              AutomationProperties.Name="选中批次的 Revision 历史"
                                              Visibility="{Binding History.HasRevisionHistory, Converter={StaticResource BoolToVisibility}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="修改前数量" Binding="{Binding PreviousCheckedQty}" Width="*" MinWidth="108" ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                            <DataGridTextColumn Header="修改后数量" Binding="{Binding NewCheckedQty}" Width="*" MinWidth="108" ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                            <DataGridTextColumn Header="修改时间"
                                                                 Binding="{Binding ChangedAtUtc, Converter={StaticResource UtcDateTimeDisplayConverter}}"
                                                                 Width="2*"
                                                                 MinWidth="196"
                                                                 ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="选择一个批次查看修改历史"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding History.HasSelectedDetailItem, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock Text="正在加载修改历史…"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding History.IsRevisionLoading, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding History.HasRevisionError, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="修改历史加载失败"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="重试"
                                                Command="{Binding History.RetryRevisionCommand}"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="该批次的修改历史不可访问"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding History.IsRevisionNotFound, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="无修改记录"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding History.HasNoRevisions, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 数据备份与恢复 -->
                <Grid Visibility="{Binding IsBackupRestoreVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <Border Style="{StaticResource PageSectionBorderStyle}"
                                    Padding="16"
                                    AutomationProperties.Name="数据备份与恢复工作区">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="备份文件"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="仅显示当前应用管理目录中已验证的备份文件。恢复前会先创建保护备份。"
                                                       Margin="0,4,0,0"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="刷新列表"
                                                Command="{Binding BackupRestore.RefreshCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="96"
                                                HorizontalAlignment="Right"
                                                AutomationProperties.Name="刷新备份列表" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="立即备份"
                                                Command="{Binding BackupRestore.CreateBackupCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Width="112"
                                                AutomationProperties.Name="立即创建并验证备份" />
                                        <TextBlock Grid.Column="1"
                                                   Text="备份完成后会自动刷新下方列表。"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="2"
                                                Content="恢复所选备份"
                                                Command="{Binding BackupRestore.RestoreCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Width="136"
                                                AutomationProperties.Name="恢复所选备份"
                                                ToolTip="选择一份已验证备份后恢复；恢复前会创建保护备份" />
                                    </Grid>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Margin="0,12,0,0"
                                                AutomationProperties.Name="备份恢复状态">
                                        <ProgressBar Width="120"
                                                     Height="8"
                                                     IsIndeterminate="True"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding BackupRestore.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding BackupRestore.StatusMessage}"
                                                   Margin="0,0,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding BackupRestore.ErrorMessage}"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource DangerBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding BackupRestore.HasError, Converter={StaticResource BoolToVisibility}}"
                                               AutomationProperties.Name="备份恢复错误" />

                                    <Grid Grid.Row="4" MinHeight="230" Margin="0,16,0,0">
                                        <Border Style="{StaticResource BackupListSurfaceStyle}">
                                            <DataGrid ItemsSource="{Binding BackupRestore.Backups}"
                                                      Style="{StaticResource BackupListDataGridStyle}"
                                                      SelectedItem="{Binding BackupRestore.SelectedBackup, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="True"
                                                      IsEnabled="{Binding BackupRestore.CanRefresh}"
                                                      SelectionMode="Single"
                                                      SelectionUnit="FullRow"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      BorderThickness="0"
                                                      IsTabStop="True"
                                                      Focusable="True"
                                                      AutomationProperties.Name="已验证备份列表">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="创建时间"
                                                                         Binding="{Binding CreatedAtText}"
                                                                         Width="170"
                                                                         ElementStyle="{StaticResource TableCellTextStyle}" />
                                                    <DataGridTemplateColumn Header="备份" Width="220">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="本地备份"
                                                                           Style="{StaticResource TableCellTextStyle}"
                                                                           ToolTip="{Binding FileName}"
                                                                           AutomationProperties.Name="本地备份，技术文件名可在提示中查看" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="文件大小"
                                                                         Binding="{Binding FileSize, Converter={StaticResource HumanReadableFileSizeConverter}}"
                                                                         Width="120"
                                                                         ElementStyle="{StaticResource TableCellTextStyle}" />
                                                    <DataGridTextColumn Header="验证状态"
                                                                         Binding="{Binding VerificationStatusText}"
                                                                         Width="*"
                                                                         MinWidth="150"
                                                                         ElementStyle="{StaticResource TableCellTextStyle}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                        <Border Style="{StaticResource StateMessageBorderStyle}"
                                                Margin="12"
                                                Visibility="{Binding BackupRestore.IsLoading, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="正在加载备份列表…"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="只显示应用验证通过的本地备份。"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StateMessageBorderStyle}"
                                                Margin="12"
                                                Visibility="{Binding BackupRestore.HasNoBackups, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="当前没有可恢复备份"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="创建并验证第一份备份后，它会显示在这里。"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="下一步：选择“立即备份”。"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="4"
                                            Margin="0,16,0,0"
                                            Padding="12"
                                            Background="{DynamicResource WarningSurfaceBrush}"
                                            BorderBrush="{DynamicResource WarningTextBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding BackupRestore.IsLocked, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="操作已锁定"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="恢复成功，需要退出并重新启动应用。"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding BackupRestore.IsRestartRequired, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="恢复过程未能确认当前数据状态。"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding BackupRestore.IsCriticalFailure, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding BackupRestore.StatusMessage}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="下一步：退出应用，并按提示处理保护备份。"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <Button Content="退出应用"
                                                    Command="{Binding BackupRestore.ExitApplicationCommand}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Width="104"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,10,0,0"
                                                    AutomationProperties.Name="退出应用" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 排查详情 -->
                <Grid x:Name="InspectionDetailPage"
                      MinHeight="0"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding IsInspectionDetailVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid x:Name="InspectionDetailRoot"
                          MinHeight="0"
                          VerticalAlignment="Stretch"
                          Visibility="{Binding Detail.IsOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <Border
                                Padding="16,12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Detail.ProductName}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="132" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="商品条码："
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Detail.ProductBarcode, Mode=OneWay}"
                                                 Style="{StaticResource ReadOnlyIdentityTextBoxStyle}"
                                                 Width="132"
                                                 AutomationProperties.Name="商品条码"
                                                 ToolTip="商品条码，可复制" />
                                        <TextBlock Grid.Column="2"
                                                   Text="商品编码："
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="16,0,0,0" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding Detail.ProductCode, Mode=OneWay}"
                                                 Style="{StaticResource ReadOnlyIdentityTextBoxStyle}"
                                                 Width="132"
                                                 AutomationProperties.Name="商品编码"
                                                 ToolTip="商品编码，可复制" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="当前库存" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail.EffectiveStockQty}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryActionBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="待排查批次" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail.PendingBatchCount}"
                                                FontSize="22"
                                               FontWeight="SemiBold"
                                                Foreground="{DynamicResource WarningTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="3"
                                        Content="修正库存"
                                        Command="{Binding Detail.OpenInventoryCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="16,0,0,0"
                                        AutomationProperties.Name="修正库存"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border
                                Padding="16,12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="排查信息" FontSize="16" FontWeight="SemiBold" />
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="排查人" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                     <TextBox Grid.Column="1"
                                               Text="{Binding Detail.InspectorName, UpdateSourceTrigger=PropertyChanged}"
                                               AutomationProperties.Name="排查人"
                                               ToolTip="请填写排查人后再完成排查"
                                               Style="{StaticResource InspectionInspectorNameTextBoxStyle}"
                                             IsEnabled="{Binding Detail.CanEdit}" />
                                    <TextBlock Grid.Column="2" Text="排查日期" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="24,0,10,0" />
                                    <DatePicker Grid.Column="3"
                                                SelectedDate="{Binding Detail.CheckDateValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                DisplayDateEnd="{Binding Detail.CheckDateMaxValue, Mode=OneWay}"
                                                SelectedDateFormat="Short"
                                                IsEnabled="{Binding Detail.CanEdit}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,12"
                                Visibility="{Binding Detail.IsInventoryEditorVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="新库存" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource PageTextBoxStyle}"
                                         Text="{Binding Detail.InventoryText, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Right"
                                         ToolTip="请输入非负整数" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Detail.InventoryError}"
                                           Foreground="#A4262C"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <Button Grid.Column="3"
                                        Content="取消"
                                        Command="{Binding Detail.CancelInventoryCommand}"
                                        Margin="12,0,8,0" />
                                <Button Grid.Column="4"
                                        Content="保存修正"
                                        Command="{Binding Detail.AdjustInventoryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0" />
                            </Grid>
                        </Border>

                        </StackPanel>

                        <ScrollViewer x:Name="DetailScrollViewer"
                                      Grid.Row="1"
                                      MinHeight="0"
                                      VerticalAlignment="Stretch"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      CanContentScroll="False"
                                      Focusable="True"
                                      IsTabStop="True"
                                      Margin="0,0,0,12">
                            <StackPanel>

                        <StackPanel Margin="0,0,0,12" MinWidth="900">
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="6,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="阶段" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="生产日期" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="有效日期" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="累计到货" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="上次排查" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="本次排查数量" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="状态 / 操作" Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                            </Border>
                                    <Border Grid.Row="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,6,6">
                                        <ItemsControl ItemsSource="{Binding Detail.TaskItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0,4"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding RequiresReconfirmation}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ReconfirmSurfaceBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasInputError}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid MinHeight="48">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="78" />
                                                                 <ColumnDefinition Width="112" />
                                                                 <ColumnDefinition Width="112" />
                                                                 <ColumnDefinition Width="100" />
                                                                 <ColumnDefinition Width="150" />
                                                                 <ColumnDefinition Width="148" />
                                                                 <ColumnDefinition Width="200" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentControl Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource DetailStageBadgeTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ProductionDate, Converter={StaticResource DateOnlyDisplayConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{Binding CurrentArrivalQty}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="{Binding LastInspectionText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                                             <TextBox Grid.Column="5"
                                                                     Style="{StaticResource PageTextBoxStyle}"
                                                                     Text="{Binding CheckedQtyText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Height="36"
                                                                     Margin="8,0"
                                                                     HorizontalContentAlignment="Right"
                                                                     VerticalContentAlignment="Center"
                                                                     IsEnabled="{Binding DataContext.Detail.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     ToolTip="空白=未检查；0=现场无该批次"
                                                                     AutomationProperties.Name="本次排查数量" />
                                                              <Grid Grid.Column="6" Margin="8,0" VerticalAlignment="Center">
                                                                  <StackPanel Orientation="Horizontal"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center">
                                                                     <Border Style="{StaticResource InspectionStatusTagStyle}">
                                                                         <TextBlock Style="{StaticResource InspectionStatusTagTextStyle}" />
                                                                     </Border>
                                                                     <Button Content="重新确认"
                                                                             Command="{Binding ReconfirmCommand}"
                                                                             Visibility="{Binding RequiresReconfirmation, Converter={StaticResource BoolToVisibility}}"
                                                                             Style="{StaticResource SecondaryButtonStyle}"
                                                                             Height="32"
                                                                             Padding="8,0"
                                                                             Margin="8,0,0,0" />
                                                                 </StackPanel>
                                                              </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                            </Border>
                            </Grid>

                        <Expander IsExpanded="False"
                                  AutomationProperties.Name="其他正常批次"
                                  Visibility="{Binding Detail.HasNormalBatches, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <Grid MinHeight="34" Background="Transparent">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock AutomationProperties.Name="展开状态">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▶" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                    <Setter Property="Margin" Value="0,0,8,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                            <Setter Property="Text" Value="▼" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail.NormalBatchCount, StringFormat=其他正常批次（{0}）}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                                            <Grid MinWidth="900">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="34" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Background="{DynamicResource SurfaceSubtleBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="阶段" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="生产日期" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="有效日期" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="累计到货" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </Grid>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Detail.NormalBatches}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid MinHeight="32" Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1*" />
                                                                        <ColumnDefinition Width="1*" />
                                                                        <ColumnDefinition Width="1*" />
                                                                        <ColumnDefinition Width="1*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="正常" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding ProductionDate, Converter={StaticResource DateOnlyDisplayConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding ExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding CurrentArrivalQty}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Expander>
                                        <TextBlock Text="{Binding Detail.FeedbackMessage}"
                                                   Visibility="{Binding Detail.HasFeedback, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Margin="8,8,8,0" />
                                    </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,0,0,0">
                            <StackPanel>
                                <Border Background="{DynamicResource ErrorSurfaceBrush}"
                                        BorderBrush="{DynamicResource DangerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding Detail.HasActionError, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="提交失败">
                                    <StackPanel>
                                        <TextBlock Text="提交失败"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="{Binding Detail.ActionErrorMessage}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="下一步：请修改后重新提交；如仍失败请重试。"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="56"
                                    Padding="12,8">
                                <Grid Visibility="{Binding Detail.ShowSubmitFooter, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Foreground, ElementName=DraftFooterStatusText}" Margin="4,0,10,0" />
                                        <TextBlock x:Name="DraftFooterStatusText"
                                                   Text="{Binding Detail.DraftFooterStatusText}"
                                                   Style="{StaticResource DraftFooterStatusTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="重试"
                                                Command="{Binding Detail.RetrySaveCommand}"
                                                Visibility="{Binding Detail.SaveFailed, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="清空草稿"
                                            Command="{Binding Detail.ClearDraftCommand}"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Margin="16,0,8,0" />
                                    <Button Grid.Column="2"
                                            Content="修正库存"
                                            Command="{Binding Detail.OpenInventoryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,12,0" />
                                    <Button Grid.Column="3"
                                            Content="{Binding Detail.SubmitButtonText}"
                                            Command="{Binding Detail.SubmitCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="132"
                                            Margin="0" />
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource WarningSurfaceBrush}"
                                    BorderBrush="#E5CE70"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="56"
                                    Padding="12,8"
                                    Visibility="{Binding Detail.HasOverStockConfirmation, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Detail.OverStockMessage}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningTextBrush}" />
                                        <TextBlock Foreground="{DynamicResource WarningTextBrush}" Margin="0,4,0,0">
                                            <Run Text="当前库存：" />
                                            <Run Text="{Binding Detail.OverStockEffectiveStockQty, Mode=OneWay}" />
                                            <Run Text="    排查合计：" />
                                            <Run Text="{Binding Detail.OverStockTotalCheckedQty, Mode=OneWay}" />
                                            <Run Text="    超出：" />
                                            <Run Text="{Binding Detail.OverStockExcessQty, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button x:Name="ReturnFromOverStockButton"
                                                Content="返回修改排查件数"
                                                Command="{Binding Detail.ReturnFromOverStockCommand}"
                                                IsVisibleChanged="ReturnFromOverStockButton_IsVisibleChanged"
                                                Margin="0,0,8,0" />
                                        <Button Content="修正库存"
                                                Command="{Binding Detail.OpenInventoryCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="确认仍然提交"
                                                Command="{Binding Detail.ConfirmOverStockCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0" />
                                     </WrapPanel>
                                 </Grid>
                             </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Detail.IsTerminal, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Detail.StatusMessage}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Detail.CloseReasonText}"
                                   Visibility="{Binding Detail.HasCloseReason, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail.SubmissionCompletedAtText}"
                                   Visibility="{Binding Detail.HasSubmissionCompletedAt, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SuccessBrush}" />
                        <Button Content="返回待排查任务"
                                Command="{Binding Detail.BackCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Detail.HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Detail.ErrorMessage}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="#A4262C" />
                        <TextBlock Text="{Binding Detail.ActionErrorMessage}"
                                   Visibility="{Binding Detail.HasActionError, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#A4262C"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="重试"
                                    Command="{Binding Detail.RetryLoadCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="返回待排查任务"
                                    Command="{Binding Detail.BackCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="正在加载…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding Detail.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- 数据导入 -->
                <Grid Visibility="{Binding IsImportVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <Border Style="{StaticResource PageSectionBorderStyle}"
                                    Padding="16"
                                    AutomationProperties.Name="Excel 文件身份与解析状态">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="文件来源" FontSize="16" FontWeight="SemiBold" />
                                        <Button Content="选择 Excel 文件"
                                                Click="SelectExcel_Click"
                                                IsEnabled="{Binding Import.CanSelectFile}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="180"
                                                HorizontalAlignment="Left"
                                                Margin="0,16,0,0"
                                                AutomationProperties.Name="选择 Excel 文件" />
                                        <TextBlock Text="支持标准 .xlsx 文件"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1,0,0,0"
                                            Padding="24,0,0,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="当前文件" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Import.SelectedFileName}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="0,8,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Import.SelectedFileName}" />
                                            <TextBlock Text="{Binding Import.SelectedFilePath}"
                                                       FontFamily="Segoe UI, Microsoft YaHei UI"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Import.SelectedFilePath}" />
                                            <TextBlock Text="{Binding Import.ChangeStatusText}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryActionBrush}"
                                                       Margin="0,8,0,0"
                                                       Visibility="{Binding Import.IsSucceeded, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBlock Text="{Binding Import.StatusMessage}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,8,0,0"
                                                       Visibility="{Binding Import.IsSucceeded, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBlock Text="{Binding Import.ErrorMessage}"
                                                       Visibility="{Binding Import.HasError, Converter={StaticResource BoolToVisibility}}"
                                                       TextWrapping="Wrap"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Import.RefreshErrorMessage}"
                                                       Visibility="{Binding Import.HasRefreshError, Converter={StaticResource BoolToVisibility}}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource WarningTextBrush}"
                                                       Margin="0,8,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <ProgressBar Width="150"
                                                             Height="8"
                                                             IsIndeterminate="True"
                                                             Visibility="{Binding Import.IsConfirming, Converter={StaticResource BoolToVisibility}}"
                                                             VerticalAlignment="Center" />
                                                <TextBlock Text="正在解析文件，请稍候…"
                                                           Visibility="{Binding Import.IsParsing, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="正在导入，请稍候…"
                                                           Visibility="{Binding Import.IsConfirming, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <Button Content="重试"
                                                         Command="{Binding Import.RetryCommand}"
                                                         Visibility="{Binding Import.CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                         Style="{StaticResource LinkButtonStyle}"
                                                         Margin="12,0,0,0"
                                                         AutomationProperties.Name="重试导入" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                             </Border>

                             <Border Margin="0,12,0,0"
                                     Padding="14,12"
                                     Background="{DynamicResource SuccessSurfaceBrush}"
                                     BorderBrush="{DynamicResource SuccessBrush}"
                                     BorderThickness="1"
                                     CornerRadius="6"
                                     AutomationProperties.Name="导入成功结果"
                                     Visibility="{Binding Import.IsSucceeded, Converter={StaticResource BoolToVisibility}}">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="28" />
                                         <ColumnDefinition Width="*" />
                                     </Grid.ColumnDefinitions>
                                     <TextBlock Text="✓"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SuccessBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top" />
                                     <StackPanel Grid.Column="1">
                                         <TextBlock Text="导入成功"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SuccessBrush}" />
                                         <TextBlock Text="{Binding Import.SuccessSummaryText}"
                                                    Margin="0,4,0,0"
                                                    TextWrapping="Wrap"
                                                    Foreground="{DynamicResource PrimaryTextBrush}" />
                                     </StackPanel>
                                 </Grid>
                             </Border>

                             <Border Margin="0,12,0,0"
                                    Padding="16"
                                    Style="{StaticResource PageSectionBorderStyle}"
                                    AutomationProperties.Name="导入影响摘要与异常行"
                                    Visibility="{Binding Import.HasPreview, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                             <TextBlock Text="影响摘要" FontSize="16" FontWeight="SemiBold" />
                                             <TextBlock Text="{Binding Import.ChangeStatusText}"
                                                       Margin="12,2,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Visibility="{Binding Import.IsSucceeded, Converter={StaticResource InverseBoolToVisibility}}" />
                                         </StackPanel>
                                         <TextBlock Grid.Column="1"
                                                    Text="{Binding Import.ConfirmAvailabilityText}"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Import.IsSucceeded, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0" MinHeight="64">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="涉及商品" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Import.InvolvedProductCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Margin="12,0" Background="{DynamicResource BorderBrush}" Width="1" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="批次数" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Import.NormalBatchKeyCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="3" Margin="12,0" Background="{DynamicResource BorderBrush}" Width="1" />
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="新增 / 更新商品" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Import.NewProductCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                                                <TextBlock Text=" / " FontSize="16" Foreground="{DynamicResource WarningTextBrush}" />
                                                <TextBlock Text="{Binding Import.UpdatedProductCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="5" Margin="12,0" Background="{DynamicResource BorderBrush}" Width="1" />
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="新增 / 更新批次" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Import.NewBatchCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                                                <TextBlock Text=" / " FontSize="16" Foreground="{DynamicResource WarningTextBrush}" />
                                                <TextBlock Text="{Binding Import.UpdatedBatchCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="7" Margin="12,0" Background="{DynamicResource BorderBrush}" Width="1" />
                                        <StackPanel Grid.Column="8">
                                            <TextBlock Text="数据异常" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Import.WarningCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="数据异常" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Import.WarningCount, StringFormat=（{0} 条）}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="8,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="异常行不会阻止其他有效数据导入"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Import.HasWarningDetails, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding Import.IssueRows}"
                                              AutoGenerateColumns="False"
                                              SelectionMode="Single"
                                              SelectionUnit="Cell"
                                              ClipboardCopyMode="ExcludeHeader"
                                              Height="188"
                                              BorderThickness="1"
                                              AutomationProperties.Name="Excel 导入异常行列表"
                                              Visibility="{Binding Import.HasWarningDetails, Converter={StaticResource BoolToVisibility}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="行号" Binding="{Binding ExcelRowNumber}" Width="72" />
                                            <DataGridTextColumn Header="商品编码" Binding="{Binding ProductCode}" Width="156" />
                                            <DataGridTextColumn Header="问题类型" Binding="{Binding IssueType}" Width="116" />
                                            <DataGridTextColumn Header="问题说明" Binding="{Binding Description}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="未发现数据异常"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Margin="0,12,0,0"
                                               Visibility="{Binding Import.HasWarningDetails, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Import.ConfirmAvailabilityText}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource ImportAvailabilityTextStyle}" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding Import.HasPreview, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="取消"
                                            Command="{Binding NavigateHomeCommand}"
                                            Width="92"
                                            Margin="0,0,12,0"
                                            AutomationProperties.Name="取消本次导入" />
                                    <Button Content="确认导入"
                                            Command="{Binding Import.ConfirmCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="112"
                                            AutomationProperties.Name="确认导入 Excel 数据" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
