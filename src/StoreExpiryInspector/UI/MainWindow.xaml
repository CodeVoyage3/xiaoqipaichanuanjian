<Window x:Class="StoreExpiryInspector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StoreExpiryInspector.UI"
        Title="门店效期排查软件"
        Width="1280"
        Height="760"
        MinWidth="1024"
        MinHeight="600"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Language="zh-CN"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="Window_SizeChanged">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Window.Resources>
        <ui:StageLabelConverter x:Key="StageLabelConverter" />
        <ui:DateOnlyDisplayConverter x:Key="DateOnlyDisplayConverter" />
        <ui:UtcDateTimeDisplayConverter x:Key="UtcDateTimeDisplayConverter" />
        <ui:Stage4BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:Stage4InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <ui:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />

        <Style x:Key="DraftFooterStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Detail.HasRecoveredDraft}" Value="True" />
                        <Condition Binding="{Binding Detail.HasUnsavedChanges}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Detail.IsSaving}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Detail.SaveFailed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StageBadgeTemplate">
            <Border Padding="8,2"
                    Height="26"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                        <Setter Property="TextElement.Foreground" Value="#475569" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HighestStage}" Value="expired">
                                <Setter Property="Background" Value="#FDECEC" />
                                <Setter Property="BorderBrush" Value="#E5A3A8" />
                                <Setter Property="TextElement.Foreground" Value="#A4262C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="withdraw">
                                <Setter Property="Background" Value="#FFF0E5" />
                                <Setter Property="BorderBrush" Value="#F2B58B" />
                                <Setter Property="TextElement.Foreground" Value="#9A3412" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="discount_20">
                                <Setter Property="Background" Value="#FFF8D6" />
                                <Setter Property="BorderBrush" Value="#E5CE70" />
                                <Setter Property="TextElement.Foreground" Value="#7A5900" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestStage}" Value="discount_50">
                                <Setter Property="Background" Value="#EAF2FF" />
                                <Setter Property="BorderBrush" Value="#9FC1F5" />
                                <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding HighestStage, Converter={StaticResource StageLabelConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DetailStageBadgeTemplate">
            <Border Padding="8,2"
                    Height="26"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                        <Setter Property="TextElement.Foreground" Value="#475569" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="expired">
                                <Setter Property="Background" Value="#FDECEC" />
                                <Setter Property="BorderBrush" Value="#E5A3A8" />
                                <Setter Property="TextElement.Foreground" Value="#A4262C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="withdraw">
                                <Setter Property="Background" Value="#FFF0E5" />
                                <Setter Property="BorderBrush" Value="#F2B58B" />
                                <Setter Property="TextElement.Foreground" Value="#9A3412" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="discount_20">
                                <Setter Property="Background" Value="#FFF8D6" />
                                <Setter Property="BorderBrush" Value="#E5CE70" />
                                <Setter Property="TextElement.Foreground" Value="#7A5900" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="discount_50">
                                <Setter Property="Background" Value="#EAF2FF" />
                                <Setter Property="BorderBrush" Value="#9FC1F5" />
                                <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Stage, Converter={StaticResource StageLabelConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HistoryStageBadgeTemplate">
            <Border Padding="8,2"
                    Height="26"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                        <Setter Property="TextElement.Foreground" Value="#475569" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="expired">
                                <Setter Property="Background" Value="#FDECEC" />
                                <Setter Property="BorderBrush" Value="#E5A3A8" />
                                <Setter Property="TextElement.Foreground" Value="#A4262C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="withdraw">
                                <Setter Property="Background" Value="#FFF0E5" />
                                <Setter Property="BorderBrush" Value="#F2B58B" />
                                <Setter Property="TextElement.Foreground" Value="#9A3412" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="discount_20">
                                <Setter Property="Background" Value="#FFF8D6" />
                                <Setter Property="BorderBrush" Value="#E5CE70" />
                                <Setter Property="TextElement.Foreground" Value="#7A5900" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="discount_50">
                                <Setter Property="Background" Value="#EAF2FF" />
                                <Setter Property="BorderBrush" Value="#9FC1F5" />
                                <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StageSnapshot}" Value="none">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="TextElement.Foreground" Value="#475569" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StageSnapshot, Converter={StaticResource StageLabelConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <Style x:Key="HistoryCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellColumn" Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="16,24,12,24" Orientation="Horizontal">
                    <Border Width="32"
                            Height="32"
                            Background="{DynamicResource PrimaryActionBrush}"
                            CornerRadius="7"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource ShieldIcon}"
                              Fill="White"
                              Stretch="Uniform"
                              Margin="7" />
                    </Border>
                    <TextBlock Margin="8,0,0,0"
                               Text="门店效期排查软件"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0,12,0">
                    <Button AutomationProperties.Name="首页"
                            Command="{Binding NavigateHomeCommand}"
                            Tag="{Binding IsDashboardVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource HomeIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock Text="首页" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="待排查任务"
                            Command="{Binding NavigateTasksCommand}"
                            Tag="{Binding IsPendingTasksVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ClipboardIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock Text="待排查任务" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="排查历史"
                            Command="{Binding NavigateHistoryCommand}"
                            Tag="{Binding IsHistoryVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FileIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock Text="排查历史" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="数据导入"
                            Command="{Binding NavigateImportCommand}"
                            Tag="{Binding IsImportVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ImportIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock Text="数据导入" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="数据备份与恢复"
                            Command="{Binding NavigateBackupRestoreCommand}"
                            Tag="{Binding IsBackupRestoreVisible}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ShieldIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock Text="数据备份与恢复" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="设置"
                            ToolTip="提醒时间与开机自启动"
                            Click="Settings_Click"
                            IsEnabled="{Binding CanOpenSettings}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GearIcon}"
                                  Style="{StaticResource NavIconPathStyle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  />
                            <TextBlock Text="设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="20,16,16,20">
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,0,0,12" />
                    <TextBlock Text="软件版本：v1.0.0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentRoot"
              Grid.Column="1"
              Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,24,0,20"
                  Visibility="{Binding IsInspectionDetailVisible, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding PageSubtitle}"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        AutomationProperties.Name="导入数据"
                        Content="导入数据"
                        Command="{Binding NavigateImportCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}"
                        VerticalAlignment="Center"
                        Padding="18,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ImportIcon}"
                                      Width="18"
                                      Height="18"
                                      Stroke="White"
                                      StrokeThickness="1.7"
                                      Fill="Transparent"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="导入数据" Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </Grid>

            <Grid Grid.Row="0"
                  Margin="0,20,0,12"
                  Visibility="{Binding IsInspectionDetailVisible, Converter={StaticResource BoolToVisibility}}">
                <Button HorizontalAlignment="Left"
                        Content="←  返回待排查任务"
                        Command="{Binding Detail.BackCommand}"
                        Style="{StaticResource LinkButtonStyle}"
                        AutomationProperties.Name="返回待排查任务" />
            </Grid>

            <Grid Grid.Row="1">
                <!-- 首页 -->
                <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer x:Name="DashboardScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <Border Padding="14,0"
                                    Height="50"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource SearchIcon}"
                                          Width="20"
                                          Height="20"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="1.6"
                                          Fill="Transparent"
                                          VerticalAlignment="Center" />
                                    <TextBox x:Name="HomeSearchBox"
                                             Grid.Column="1"
                                             Height="46"
                                             BorderThickness="0"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding PendingTasks.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="搜索商品名称、商品条码或商品编码">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchTasksCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Grid.Column="1"
                                               Text="搜索商品名称 / 商品条码 / 商品编码"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Foreground="#8995AA"
                                               FontSize="14"
                                               Visibility="{Binding PendingTasks.SearchText, Converter={StaticResource EmptyStringToVisibility}}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid Height="76">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource ClipboardIcon}" Width="24" Height="24" Stroke="{DynamicResource PrimaryActionBrush}" StrokeThickness="1.8" Fill="Transparent" Margin="0,0,10,0" />
                                        <TextBlock Text="待排查 " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Dashboard.OpenTaskCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryActionBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="38" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Ellipse Width="24" Height="24" Fill="#FDECEC" Margin="0,0,10,0" />
                                        <TextBlock Text="过期 " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Dashboard.ExpiredCount}" FontSize="22" FontWeight="SemiBold" Foreground="#E52B32" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Height="38" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource HomeIcon}" Width="24" Height="24" Stroke="#F27A16" StrokeThickness="1.8" Fill="Transparent" Margin="0,0,10,0" />
                                        <TextBlock Text="收仓 " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Dashboard.WithdrawCount}" FontSize="22" FontWeight="SemiBold" Foreground="#F27A16" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="5" Height="38" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="%" FontSize="19" FontWeight="SemiBold" Foreground="#F27A16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="2折 " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Dashboard.Discount20Count}" FontSize="22" FontWeight="SemiBold" Foreground="#F27A16" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="7" Height="38" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="%" FontSize="19" FontWeight="SemiBold" Foreground="#0E9F58" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="5折 " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Dashboard.Discount50Count}" FontSize="22" FontWeight="SemiBold" Foreground="#0E9F58" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="14,0"
                                    Height="48"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dashboard.IsStale}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Dashboard.HasError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" Margin="4,0,10,0" />
                                        <TextBlock Text="{Binding Dashboard.LastImportText}" FontSize="14" />
                                        <TextBlock Text="{Binding Dashboard.FreshnessWarningText}"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="16,0,0,0" />
                                        <Border Margin="16,0" Height="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" />
                                        <TextBlock Text="{Binding Dashboard.ProductCount, StringFormat={}{0} 个商品}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text=" / " FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Dashboard.BatchCount, StringFormat={}{0} 个批次}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,20,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="优先处理" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="按紧急程度和最近有效期排序"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,2,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Content="查看全部待排查任务  →"
                                        Command="{Binding Dashboard.ViewAllTasksCommand}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Margin="0" />
                            </Grid>
                            <TextBlock Text="正在加载…"
                                       Visibility="{Binding Dashboard.IsLoading, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="暂无导入数据"
                                       Visibility="{Binding Dashboard.HasNoImportData, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="当前没有待排查任务"
                                       Visibility="{Binding Dashboard.HasNoOpenTasks, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{Binding Dashboard.ErrorMessage}"
                                       Visibility="{Binding Dashboard.HasError, Converter={StaticResource BoolToVisibility}}"
                                       Foreground="#A4262C"
                                       Margin="0,0,0,8" />
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding Dashboard.HasError, Converter={StaticResource InverseBoolToVisibility}}">
                                <DataGrid x:Name="DashboardUrgentTasksDataGrid"
                                          ItemsSource="{Binding Dashboard.UrgentTasks}"
                                          AutoGenerateColumns="False"
                                          IsTabStop="True"
                                          Focusable="True"
                                          SelectionMode="Single"
                                          SelectionUnit="Cell"
                                          ClipboardCopyMode="ExcludeHeader"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          PreviewMouseWheel="DashboardDataGrid_PreviewMouseWheel">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="阶段" Width="82">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StageBadgeTemplate}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="*" />
                                        <DataGridTextColumn Header="商品条码" Binding="{Binding ProductBarcode}" Width="150" />
                                        <DataGridTextColumn Header="库存" Binding="{Binding EffectiveStockQty}" Width="72" />
                                        <DataGridTextColumn Header="最近有效期"
                                                             Binding="{Binding NearestExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                             Width="124" />
                                        <DataGridTemplateColumn Header="操作" Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="排查  →"
                                                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            Height="32"
                                                            Padding="4,0"
                                                            Margin="0" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 待排查任务 -->
                <Grid Visibility="{Binding IsPendingTasksVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="TaskSearchBox"
                                     Height="48"
                                     Padding="42,4,36,4"
                                     Text="{Binding PendingTasks.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="搜索商品名称、商品条码或商品编码">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding PendingTasks.SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Path Data="{StaticResource SearchIcon}"
                                  Width="20"
                                  Height="20"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  HorizontalAlignment="Left"
                                  Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                            <TextBlock Text="搜索商品名称 / 商品条码 / 商品编码"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="42,0,36,0"
                                       Foreground="#8995AA"
                                       FontSize="14"
                                       Visibility="{Binding PendingTasks.SearchText, Converter={StaticResource EmptyStringToVisibility}}" />
                            <Button Content="×"
                                    Command="{Binding PendingTasks.ClearFiltersCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    FontSize="18"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    ToolTip="清空搜索和阶段筛选"
                                    Visibility="{Binding PendingTasks.IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <ListBox ItemsSource="{Binding PendingTasks.StageFilters}"
                                 SelectedValuePath="CanonicalStage"
                                 SelectedIndex="0"
                                 SelectedValue="{Binding PendingTasks.SelectedStage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Left"
                                 Margin="0,0,24,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <Border Background="#F1F5F9"
                                                CornerRadius="8"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                MinWidth="24">
                                            <TextBlock x:Name="StageCountText"
                                                       Text="0"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="{x:Null}">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.OpenTaskCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="expired">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.ExpiredCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="withdraw">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.WithdrawCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="discount_20">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.Discount20Count, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanonicalStage}" Value="discount_50">
                                            <Setter TargetName="StageCountText" Property="Text" Value="{Binding DataContext.Dashboard.Discount50Count, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding PendingTasks.TotalCount, StringFormat=共 {0} 个商品}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="默认按紧急程度和最近有效期排序"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="正在加载…"
                                       Visibility="{Binding PendingTasks.IsLoading, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="清空筛选"
                                    Command="{Binding PendingTasks.ClearFiltersCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <DataGrid ItemsSource="{Binding PendingTasks.Items}"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="Cell"
                                      ClipboardCopyMode="ExcludeHeader"
                                      BorderThickness="0"
                                      IsTabStop="True"
                                      Focusable="True"
                                      Visibility="{Binding PendingTasks.HasError, Converter={StaticResource InverseBoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="阶段" Width="78">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StageBadgeTemplate}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="*" />
                                    <DataGridTextColumn Header="商品条码" Binding="{Binding ProductBarcode}" Width="142" />
                                    <DataGridTextColumn Header="商品编码" Binding="{Binding ProductCode}" Width="142" />
                                    <DataGridTextColumn Header="批次数" Binding="{Binding PendingBatchCount}" Width="76" />
                                    <DataGridTextColumn Header="库存" Binding="{Binding EffectiveStockQty}" Width="68" />
                                    <DataGridTextColumn Header="最近有效期"
                                                         Binding="{Binding NearestExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                         Width="118" />
                                    <DataGridTemplateColumn Header="操作" Width="94">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="排查  →"
                                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource LinkButtonStyle}"
                                                        Height="34"
                                                        Padding="4,0"
                                                        Margin="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding PendingTasks.HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="待排查任务加载失败"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       Foreground="#A4262C" />
                            <TextBlock Text="{Binding PendingTasks.ErrorMessage}"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Button Content="重试"
                                    Command="{Binding PendingTasks.RetryCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="88"
                                    Margin="0,16,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding PendingTasks.HasEmptyResult, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="没有符合当前条件的任务"
                                       Visibility="{Binding PendingTasks.IsFilterEmpty, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="当前没有待排查任务"
                                       Visibility="{Binding PendingTasks.IsDatabaseEmpty, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <Button Content="清空筛选"
                                    Command="{Binding PendingTasks.ClearFiltersCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Visibility="{Binding PendingTasks.IsFilterEmpty, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Text="{Binding PendingTasks.PageSummary}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="‹  上一页"
                                    Command="{Binding PendingTasks.PreviousPageCommand}"
                                    IsEnabled="{Binding PendingTasks.CanGoPrevious}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="112" />
                            <TextBlock Text="{Binding PendingTasks.CurrentPage}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="16,0,4,0" />
                            <TextBlock Text="/" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PendingTasks.TotalPages}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="4,0,16,0" />
                            <Button Content="下一页  ›"
                                    Command="{Binding PendingTasks.NextPageCommand}"
                                    IsEnabled="{Binding PendingTasks.CanGoNext}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="112" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 排查历史 -->
                <Grid Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.Resources>
                        <Style x:Key="HistoryNumberTextStyle"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource HistoryCellTextStyle}">
                            <Setter Property="FontFamily" Value="Segoe UI" />
                        </Style>
                        <Style x:Key="HistoryColumnHeaderStyle"
                               TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Left"
                                                   ToolTip="{Binding}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid Visibility="{Binding History.IsDetailVisible, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="正式排查记录"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="仅显示已完成的正式排查；数据来自历史快照"
                                           Margin="0,4,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Content="刷新"
                                    Command="{Binding History.RefreshCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="88"
                                    HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding History.HasError, Converter={StaticResource InverseBoolToVisibility}}">
                                <DataGrid ItemsSource="{Binding History.Items}"
                                          AutoGenerateColumns="False"
                                          ColumnWidth="Auto"
                                          ColumnHeaderStyle="{StaticResource HistoryColumnHeaderStyle}"
                                          SelectionMode="Single"
                                          SelectionUnit="Cell"
                                          ClipboardCopyMode="ExcludeHeader"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          IsTabStop="True"
                                          Focusable="True"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="商品名称"
                                                             Binding="{Binding ProductName, TargetNullValue=—}"
                                                             Width="*"
                                                             MinWidth="140"
                                                             ElementStyle="{StaticResource HistoryCellTextStyle}" />
                                        <DataGridTextColumn Header="商品条码"
                                                             Binding="{Binding ProductBarcode, TargetNullValue=—}"
                                                             Width="Auto"
                                                             MinWidth="138"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="商品编码"
                                                             Binding="{Binding ProductCode}"
                                                             Width="Auto"
                                                             MinWidth="126"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="正式排查时间（UTC）"
                                                             Binding="{Binding SubmittedAtUtc, Converter={StaticResource UtcDateTimeDisplayConverter}}"
                                                             Width="Auto"
                                                             MinWidth="155"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="明细数量"
                                                             Binding="{Binding ItemCount}"
                                                             Width="Auto"
                                                             MinWidth="78"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTemplateColumn Header="操作" Width="Auto" MinWidth="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="查看详情"
                                                            Command="{Binding DataContext.History.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            Height="32"
                                                            Padding="4,0"
                                                            Margin="12,0"
                                                            AutomationProperties.Name="查看排查历史详情" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <TextBlock Text="正在加载排查历史…"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Visibility="{Binding History.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding History.HasError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="排查历史加载失败"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="{Binding History.ErrorMessage}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Button Content="重试"
                                        Command="{Binding History.RetryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="88"
                                        Margin="0,16,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding History.HasEmptyResult, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="暂无正式排查记录"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Button Content="刷新"
                                        Command="{Binding History.RefreshCommand}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding History.IsDetailVisible, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid MinHeight="520">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="240" MinHeight="180" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="←  返回排查历史"
                                    Command="{Binding History.BackCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="返回排查历史列表" />
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        MaxWidth="360">
                                <TextBlock Text="正式排查详情"
                                           HorizontalAlignment="Right"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="正在保存…"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Visibility="{Binding History.IsEditSubmitting, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding History.EditErrorMessage}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Visibility="{Binding History.HasEditError, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding History.EditFeedbackMessage}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Visibility="{Binding History.HasEditFeedback, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding History.HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="商品名称" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding History.Detail.ProductNameSnapshot, TargetNullValue=—}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding History.Detail.ProductNameSnapshot}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="商品条码" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                                    <TextBox Text="{Binding History.Detail.BarcodeSnapshot, Mode=OneWay, TargetNullValue=—}"
                                             IsReadOnly="True"
                                             IsTabStop="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             Height="24"
                                             FontSize="13"
                                             TextWrapping="Wrap"
                                             FontFamily="Segoe UI"
                                             ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                             Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="商品编码" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBox Text="{Binding History.Detail.ProductCodeSnapshot, Mode=OneWay}"
                                             IsReadOnly="True"
                                             IsTabStop="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             Height="24"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             TextWrapping="Wrap"
                                             FontFamily="Segoe UI"
                                             ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                             Margin="0,2,0,0" />
                                    <TextBlock Text="正式排查时间（UTC）" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding History.Detail.SubmittedAtUtc, Converter={StaticResource UtcDateTimeDisplayConverter}}"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Text="正式阶段" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding History.Detail.StageSnapshot, Converter={StaticResource StageLabelConverter}}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="提交库存快照" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding History.Detail.StockQtySnapshot}"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="检查人" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding History.Detail.InspectorName, TargetNullValue=—}"
                                               FontSize="14"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="检查日期" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding History.Detail.CheckDate, Converter={StaticResource DateOnlyDisplayConverter}}"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding History.HasDetail, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid ItemsSource="{Binding History.DetailItems}"
                                          SelectedItem="{Binding History.SelectedDetailItem, Mode=TwoWay}"
                                          IsEnabled="{Binding History.CanChangeHistorySelection}"
                                          AutoGenerateColumns="False"
                                          ColumnWidth="Auto"
                                          ColumnHeaderStyle="{StaticResource HistoryColumnHeaderStyle}"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          ClipboardCopyMode="ExcludeHeader"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          IsTabStop="True"
                                          Focusable="True"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="明细编号" Binding="{Binding InspectionItemId}" Width="Auto" MinWidth="76" ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="批次编号" Binding="{Binding BatchId}" Width="Auto" MinWidth="76" ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="生产日期"
                                                             Binding="{Binding ProductionDateSnapshot, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                             Width="Auto"
                                                             MinWidth="84"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="有效日期"
                                                             Binding="{Binding ExpiryDateSnapshot, Converter={StaticResource DateOnlyDisplayConverter}}"
                                                             Width="Auto"
                                                             MinWidth="84"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTemplateColumn Header="阶段" Width="Auto" MinWidth="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding}"
                                                                    ContentTemplate="{StaticResource HistoryStageBadgeTemplate}"
                                                                    Margin="12,0"
                                                                    VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="累计到货" Binding="{Binding ArrivalQtySnapshot}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="正式排查数量" Binding="{Binding CheckedQty}" Width="Auto" MinWidth="102" ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        <DataGridTextColumn Header="更新时间（UTC）"
                                                             Binding="{Binding UpdatedAtUtc, Converter={StaticResource UtcDateTimeDisplayConverter}}"
                                                             Width="Auto"
                                                             MinWidth="155"
                                                             ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding History.IsDetailLoading, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="正在加载正式排查详情…"
                                           FontSize="15"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding History.HasDetailError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="排查详情加载失败"
                                           FontSize="16"
                                           Foreground="{DynamicResource DangerBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding History.DetailErrorMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Content="重试"
                                            Command="{Binding History.RetryDetailCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="88" />
                                    <Button Content="返回列表"
                                            Command="{Binding History.BackCommand}"
                                            Margin="8,0,0,0"
                                            Width="88" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding History.IsDetailNotFound, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="该正式排查记录不存在或已不可访问"
                                           FontSize="15"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <Button Content="返回列表"
                                        Command="{Binding History.BackCommand}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                Margin="0,12,0,0"
                                Padding="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding History.HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="修改历史" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="选择明细后查看前值 → 后值 → 时间"
                                                   FontSize="12"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Margin="12,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding History.SelectedDetailItem.InspectionItemId, StringFormat=明细 {0}}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Visibility="{Binding History.HasSelectedDetailItem, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="修改数量"
                                                Command="{Binding History.BeginEditCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="32"
                                                Margin="12,0,0,0"
                                                AutomationProperties.Name="修改选中明细数量" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Padding="10"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding History.IsEditing, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="修改正式排查数量"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="仅修改数量，商品身份与其他历史快照保持不变"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding History.EditValidationMessage}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding History.HasEditInputError, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                             <TextBlock Text="正式数量"
                                                        TextWrapping="Wrap"
                                                        VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBox Text="{Binding History.EditCheckedQtyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="96"
                                                     Height="36"
                                                     Padding="8,0"
                                                     VerticalContentAlignment="Center"
                                                     HorizontalContentAlignment="Right"
                                                     FontFamily="Segoe UI"
                                                     IsReadOnly="{Binding History.IsEditSubmitting}"
                                                     AutomationProperties.Name="新的正式排查数量" />
                                            <Button Content="保存修改"
                                                    Command="{Binding History.SaveEditCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Height="36"
                                                    Margin="8,0,0,0"
                                                    AutomationProperties.Name="确认保存数量修改" />
                                            <Button Content="取消"
                                                    Command="{Binding History.CancelEditCommand}"
                                                    Style="{StaticResource LinkButtonStyle}"
                                                    Height="36"
                                                    Margin="8,0,0,0"
                                                    AutomationProperties.Name="取消数量修改" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" MinHeight="44">
                                    <DataGrid ItemsSource="{Binding History.Revisions}"
                                              AutoGenerateColumns="False"
                                              ColumnWidth="Auto"
                                              ColumnHeaderStyle="{StaticResource HistoryColumnHeaderStyle}"
                                              SelectionMode="Single"
                                              SelectionUnit="Cell"
                                              ClipboardCopyMode="ExcludeHeader"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              Height="120"
                                              BorderThickness="0"
                                              Visibility="{Binding History.HasRevisionHistory, Converter={StaticResource BoolToVisibility}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="修改前数量" Binding="{Binding PreviousCheckedQty}" Width="*" MinWidth="108" ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                            <DataGridTextColumn Header="修改后数量" Binding="{Binding NewCheckedQty}" Width="*" MinWidth="108" ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                            <DataGridTextColumn Header="修改时间（UTC）"
                                                                 Binding="{Binding ChangedAtUtc, Converter={StaticResource UtcDateTimeDisplayConverter}}"
                                                                 Width="2*"
                                                                 MinWidth="196"
                                                                 ElementStyle="{StaticResource HistoryNumberTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="选择一条明细查看修改历史"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding History.HasSelectedDetailItem, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock Text="正在加载修改历史…"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding History.IsRevisionLoading, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding History.HasRevisionError, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="修改历史加载失败"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="重试"
                                                Command="{Binding History.RetryRevisionCommand}"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="该明细的修改历史不可访问"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding History.IsRevisionNotFound, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="无修改记录"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding History.HasNoRevisions, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 数据备份与恢复 -->
                <Grid Visibility="{Binding IsBackupRestoreVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <Border Padding="20"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="本地数据保护"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="仅显示当前应用管理目录中已验证的备份文件。恢复前会先创建保护备份。"
                                                       Margin="0,4,0,0"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="刷新列表"
                                                Command="{Binding BackupRestore.RefreshCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="96"
                                                HorizontalAlignment="Right"
                                                AutomationProperties.Name="刷新备份列表" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="立即备份"
                                                Command="{Binding BackupRestore.CreateBackupCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Width="112"
                                                AutomationProperties.Name="立即创建并验证备份" />
                                        <TextBlock Grid.Column="1"
                                                   Text="备份完成后会自动刷新下方列表。"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="2"
                                                Content="恢复所选备份"
                                                Command="{Binding BackupRestore.RestoreCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Width="136"
                                                AutomationProperties.Name="恢复所选备份" />
                                    </Grid>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding BackupRestore.StatusMessage}"
                                               Margin="0,12,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding BackupRestore.ErrorMessage}"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource DangerBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding BackupRestore.HasError, Converter={StaticResource BoolToVisibility}}" />

                                    <Grid Grid.Row="4" MinHeight="230" Margin="0,16,0,0">
                                        <Border Background="{DynamicResource CanvasBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding BackupRestore.HasError, Converter={StaticResource InverseBoolToVisibility}}">
                                            <DataGrid ItemsSource="{Binding BackupRestore.Backups}"
                                                      SelectedItem="{Binding BackupRestore.SelectedBackup, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="True"
                                                      IsEnabled="{Binding BackupRestore.CanRefresh}"
                                                      SelectionMode="Single"
                                                      SelectionUnit="FullRow"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      BorderThickness="0"
                                                      IsTabStop="True"
                                                      Focusable="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="创建时间"
                                                                         Binding="{Binding CreatedAtText}"
                                                                         Width="170" />
                                                    <DataGridTextColumn Header="备份文件 / 身份"
                                                                         Binding="{Binding FileName}"
                                                                         Width="*" />
                                                    <DataGridTextColumn Header="文件大小"
                                                                         Binding="{Binding FileSizeText}"
                                                                         Width="120" />
                                                    <DataGridTextColumn Header="验证状态"
                                                                         Binding="{Binding VerificationStatusText}"
                                                                         Width="150" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                        <TextBlock Text="正在加载备份列表…"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Visibility="{Binding BackupRestore.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding BackupRestore.HasNoBackups, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="当前没有可恢复备份"
                                                       HorizontalAlignment="Center"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="创建并验证第一份备份后，它会显示在这里。"
                                                       Margin="0,6,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="4"
                                            Margin="0,16,0,0"
                                            Padding="12"
                                            Background="#FFF8E8"
                                            BorderBrush="#F0D59A"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding BackupRestore.IsLocked, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BackupRestore.StatusMessage}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       TextWrapping="Wrap" />
                                            <Button Content="退出应用"
                                                    Command="{Binding BackupRestore.ExitApplicationCommand}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Width="104"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,10,0,0"
                                                    AutomationProperties.Name="退出应用" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 排查详情 -->
                <Grid Visibility="{Binding IsInspectionDetailVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid Visibility="{Binding Detail.IsOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="DetailScrollViewer"
                                      Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      CanContentScroll="True"
                                      Margin="0,0,0,12">
                            <StackPanel>
                        <Border
                                Padding="16,12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Detail.ProductName}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="商品条码：" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Detail.ProductBarcode}" Margin="0,0,24,0" />
                                        <TextBlock Text="商品编码：" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Detail.ProductCode}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="当前库存" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail.EffectiveStockQty}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryActionBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="待排查批次" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail.PendingBatchCount}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="#F27A16"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="3"
                                        Content="修正库存"
                                        Command="{Binding Detail.OpenInventoryCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border
                                Padding="16,12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="排查信息" FontSize="16" FontWeight="SemiBold" />
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="排查人" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Detail.InspectorName, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding Detail.CanEdit}" />
                                    <TextBlock Grid.Column="2" Text="排查日期" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="24,0,10,0" />
                                    <DatePicker Grid.Column="3"
                                                SelectedDate="{Binding Detail.CheckDateValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                DisplayDateEnd="{Binding Detail.CheckDateMaxValue, Mode=OneWay}"
                                                SelectedDateFormat="Short"
                                                IsEnabled="{Binding Detail.CanEdit}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,12"
                                Visibility="{Binding Detail.IsInventoryEditorVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="新库存" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Detail.InventoryText, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Right"
                                         ToolTip="请输入非负整数" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Detail.InventoryError}"
                                           Foreground="#A4262C"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <Button Grid.Column="3"
                                        Content="取消"
                                        Command="{Binding Detail.CancelInventoryCommand}"
                                        Margin="12,0,8,0" />
                                <Button Grid.Column="4"
                                        Content="保存修正"
                                        Command="{Binding Detail.AdjustInventoryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,0,0,12" MinWidth="900">
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceSubtleBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="8,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="300" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="阶段" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="生产日期" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="有效日期" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="累计到货" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="上次排查" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="本次排查数量" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="状态 / 操作" Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,8,8">
                                        <ItemsControl ItemsSource="{Binding Detail.TaskItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0,4"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                        <Setter Property="Background" Value="#F3F7FF" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding RequiresReconfirmation}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ReconfirmSurfaceBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasInputError}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid MinHeight="48">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="78" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="88" />
                                                                <ColumnDefinition Width="126" />
                                                                <ColumnDefinition Width="108" />
                                                                <ColumnDefinition Width="300" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentControl Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource DetailStageBadgeTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ProductionDate, Converter={StaticResource DateOnlyDisplayConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{Binding CurrentArrivalQty}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="{Binding LastInspectionText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBox Grid.Column="5"
                                                                     Text="{Binding CheckedQtyText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Height="36"
                                                                     Margin="8,0"
                                                                     HorizontalContentAlignment="Right"
                                                                     VerticalContentAlignment="Center"
                                                                     IsEnabled="{Binding DataContext.Detail.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     ToolTip="空白=未检查；0=现场无该批次" />
                                                            <Grid Grid.Column="6" Margin="8,0" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding CheckedQtyStateText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="效期阶段或到货情况已更新，请重新确认"
                                                                               Visibility="{Binding RequiresReconfirmation, Converter={StaticResource BoolToVisibility}}"
                                                                               Foreground="{DynamicResource ReconfirmBrush}"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Content="重新确认"
                                                                        Command="{Binding ReconfirmCommand}"
                                                                        Visibility="{Binding RequiresReconfirmation, Converter={StaticResource BoolToVisibility}}"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Height="32"
                                                                        Padding="8,0"
                                                                        Margin="8,0,0,0" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                            </Border>
                            </Grid>

                        <Expander IsExpanded="False"
                                  AutomationProperties.Name="其他正常批次"
                                  Visibility="{Binding Detail.HasNormalBatches, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <Grid MinHeight="34" Background="Transparent">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock AutomationProperties.Name="展开状态">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▶" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                    <Setter Property="Margin" Value="0,0,8,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                            <Setter Property="Text" Value="▼" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail.NormalBatchCount, StringFormat=其他正常批次（{0}）}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                                            <Grid MinWidth="900">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="34" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Background="{DynamicResource SurfaceSubtleBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="阶段" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="生产日期" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="有效日期" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="累计到货" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </Grid>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Detail.NormalBatches}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid MinHeight="32" Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1*" />
                                                                        <ColumnDefinition Width="1*" />
                                                                        <ColumnDefinition Width="1*" />
                                                                        <ColumnDefinition Width="1*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="正常" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding ProductionDate, Converter={StaticResource DateOnlyDisplayConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding ExpiryDate, Converter={StaticResource DateOnlyDisplayConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding CurrentArrivalQty}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Expander>
                                        <TextBlock Text="{Binding Detail.ActionErrorMessage}"
                                                   Visibility="{Binding Detail.HasActionError, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="#A4262C"
                                                   TextWrapping="Wrap"
                                                   Margin="8,8,8,0" />
                                        <TextBlock Text="{Binding Detail.FeedbackMessage}"
                                                   Visibility="{Binding Detail.HasFeedback, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Margin="8,8,8,0" />
                                    </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,0,0,0">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8">
                                <Grid Visibility="{Binding Detail.ShowSubmitFooter, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Foreground, ElementName=DraftFooterStatusText}" Margin="4,0,10,0" />
                                        <TextBlock x:Name="DraftFooterStatusText"
                                                   Text="{Binding Detail.DraftFooterStatusText}"
                                                   Style="{StaticResource DraftFooterStatusTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="重试"
                                                Command="{Binding Detail.RetrySaveCommand}"
                                                Visibility="{Binding Detail.SaveFailed, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="清空草稿"
                                            Command="{Binding Detail.ClearDraftCommand}"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Margin="16,0,8,0" />
                                    <Button Grid.Column="2"
                                            Content="修正库存"
                                            Command="{Binding Detail.OpenInventoryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,12,0" />
                                    <Button Grid.Column="3"
                                            Content="{Binding Detail.SubmitButtonText}"
                                            Command="{Binding Detail.SubmitCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="132"
                                            Margin="0" />
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource WarningSurfaceBrush}"
                                    BorderBrush="#E5CE70"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Visibility="{Binding Detail.HasOverStockConfirmation, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Detail.OverStockMessage}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningTextBrush}" />
                                        <TextBlock Foreground="{DynamicResource WarningTextBrush}" Margin="0,4,0,0">
                                            <Run Text="当前库存：" />
                                            <Run Text="{Binding Detail.OverStockEffectiveStockQty, Mode=OneWay}" />
                                            <Run Text="    排查合计：" />
                                            <Run Text="{Binding Detail.OverStockTotalCheckedQty, Mode=OneWay}" />
                                            <Run Text="    超出：" />
                                            <Run Text="{Binding Detail.OverStockExcessQty, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button x:Name="ReturnFromOverStockButton"
                                                Content="返回修改排查件数"
                                                Command="{Binding Detail.ReturnFromOverStockCommand}"
                                                IsVisibleChanged="ReturnFromOverStockButton_IsVisibleChanged"
                                                Margin="0,0,8,0" />
                                        <Button Content="修正库存"
                                                Command="{Binding Detail.OpenInventoryCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="确认仍然提交"
                                                Command="{Binding Detail.ConfirmOverStockCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Detail.IsTerminal, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Detail.StatusMessage}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Detail.CloseReasonText}"
                                   Visibility="{Binding Detail.HasCloseReason, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail.SubmissionCompletedAtText}"
                                   Visibility="{Binding Detail.HasSubmissionCompletedAt, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SuccessBrush}" />
                        <Button Content="返回待排查任务"
                                Command="{Binding Detail.BackCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Detail.HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Detail.ErrorMessage}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="#A4262C" />
                        <TextBlock Text="{Binding Detail.ActionErrorMessage}"
                                   Visibility="{Binding Detail.HasActionError, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#A4262C"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="重试"
                                    Command="{Binding Detail.RetryLoadCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="返回待排查任务"
                                    Command="{Binding Detail.BackCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="正在加载…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding Detail.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- 数据导入 -->
                <Grid Visibility="{Binding IsImportVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="30" Height="30" Fill="{DynamicResource PrimaryActionBrush}" />
                                    <TextBlock Text="1" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-21,0,0,0" />
                                    <TextBlock Text="选择文件" Foreground="{DynamicResource PrimaryActionBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Height="1" Background="{DynamicResource PrimaryActionBrush}" VerticalAlignment="Center" Margin="12,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Ellipse Width="30" Height="30" Fill="#BFD7FF" />
                                    <TextBlock Text="2" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-21,0,0,0" />
                                    <TextBlock Text="导入预览" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                                <Border Grid.Column="3" Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="12,0" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Ellipse Width="30" Height="30" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource BorderBrush}" />
                                    <TextBlock Text="3" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-21,0,0,0" />
                                    <TextBlock Text="正在导入" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Padding="20"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="选择文件" FontSize="16" FontWeight="SemiBold" />
                                        <Button Content="选择 Excel 文件"
                                                Click="SelectExcel_Click"
                                                IsEnabled="{Binding Import.CanSelectFile}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="180"
                                                HorizontalAlignment="Left"
                                                Margin="0,16,0,0" />
                                        <TextBlock Text="支持标准 .xlsx 文件"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1,0,0,0"
                                            Padding="24,0,0,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="当前文件" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Import.SelectedFileName}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Import.StatusMessage}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Import.ErrorMessage}"
                                                       Visibility="{Binding Import.HasError, Converter={StaticResource BoolToVisibility}}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#A4262C"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Import.RefreshErrorMessage}"
                                                       Visibility="{Binding Import.HasRefreshError, Converter={StaticResource BoolToVisibility}}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource WarningTextBrush}"
                                                       Margin="0,8,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <ProgressBar Width="150"
                                                             Height="8"
                                                             IsIndeterminate="True"
                                                             Visibility="{Binding Import.IsConfirming, Converter={StaticResource BoolToVisibility}}"
                                                             VerticalAlignment="Center" />
                                                <TextBlock Text="正在处理…"
                                                           Visibility="{Binding Import.IsParsing, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="正在导入，请稍候…"
                                                           Visibility="{Binding Import.IsConfirming, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <Button Content="重试"
                                                        Command="{Binding Import.RetryCommand}"
                                                        Visibility="{Binding Import.CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                        Style="{StaticResource LinkButtonStyle}"
                                                        Margin="12,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding Import.HasPreview, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="导入预览" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <UniformGrid Columns="5" Margin="0,14,0,0">
                                        <Border Margin="0,0,8,0" Padding="12" Background="#F4F8FF" BorderBrush="#DCE8FF" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="涉及商品" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Import.InvolvedProductCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,8,0" Padding="12" Background="#F3FBF6" BorderBrush="#D8F0E0" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="批次数" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Import.NormalBatchKeyCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,8,0" Padding="12" Background="#FFF9F0" BorderBrush="#FCE5C5" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="新增 / 更新商品" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Import.NewProductCount}" FontSize="24" FontWeight="SemiBold" Foreground="#C96D0B" />
                                                    <TextBlock Text=" / " FontSize="20" Foreground="#C96D0B" />
                                                    <TextBlock Text="{Binding Import.UpdatedProductCount}" FontSize="24" FontWeight="SemiBold" Foreground="#C96D0B" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12" Background="#FFF9F0" BorderBrush="#FCE5C5" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="新增 / 更新批次" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Import.NewBatchCount}" FontSize="24" FontWeight="SemiBold" Foreground="#C96D0B" />
                                                    <TextBlock Text=" / " FontSize="20" Foreground="#C96D0B" />
                                                    <TextBlock Text="{Binding Import.UpdatedBatchCount}" FontSize="24" FontWeight="SemiBold" Foreground="#C96D0B" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12" Background="#FFF2F2" BorderBrush="#F6D1D1" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="数据异常" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Import.WarningCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="数据异常" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Import.WarningCount, StringFormat=（{0} 条）}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="8,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="异常行不会阻止其他有效数据导入"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Import.HasWarningDetails, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding Import.IssueRows}"
                                              AutoGenerateColumns="False"
                                              SelectionMode="Single"
                                              SelectionUnit="Cell"
                                              ClipboardCopyMode="ExcludeHeader"
                                              Height="188"
                                              BorderThickness="1"
                                              Visibility="{Binding Import.HasWarningDetails, Converter={StaticResource BoolToVisibility}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="行号" Binding="{Binding ExcelRowNumber}" Width="72" />
                                            <DataGridTextColumn Header="商品编码" Binding="{Binding ProductCode}" Width="156" />
                                            <DataGridTextColumn Header="问题类型" Binding="{Binding IssueType}" Width="116" />
                                            <DataGridTextColumn Header="问题说明" Binding="{Binding Description}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="未发现数据异常"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Margin="0,12,0,0"
                                               Visibility="{Binding Import.HasWarningDetails, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Import.ConfirmAvailabilityText}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Import.CanConfirm, Converter={StaticResource InverseBoolToVisibility}}" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding Import.HasPreview, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="取消"
                                            Command="{Binding NavigateHomeCommand}"
                                            Width="92"
                                            Margin="0,0,12,0" />
                                    <Button Content="确认导入"
                                            Command="{Binding Import.ConfirmCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="112" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
