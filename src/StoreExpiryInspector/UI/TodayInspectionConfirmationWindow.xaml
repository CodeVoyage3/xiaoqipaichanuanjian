<Window x:Class="StoreExpiryInspector.UI.TodayInspectionConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StoreExpiryInspector.UI"
        Title="排查结果确认" Width="1080" Height="600" MinWidth="880" MinHeight="500" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StageBadgeResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="ConfirmationGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="ConfirmationGridCenterHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ConfirmationGridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ConfirmationInspectorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasInspectorNameError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ConfirmationDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="6,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><Grid><DatePickerTextBox x:Name="PART_TextBox" Margin="8,0,30,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"/><Button x:Name="PART_Button" Width="30" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"><Path Data="{StaticResource CalendarIcon}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></Grid></Border><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True"><Border Margin="0,4,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5"><Calendar x:Name="PART_Calendar" /></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding HasCheckDateError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ConfirmationCellTextStyle" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <Style x:Key="ConfirmationCellCenterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ConfirmationCellTextStyle}"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
        <Style x:Key="PreviewFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryActionBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="排查结果确认" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PreviewSummaryText}" Margin="0,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusText}" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding PreviewIssueText}" Margin="0,4,0,0" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <RadioButton Content="{Binding AllPreviewFilterText}" Command="{Binding PreviewFilterCommand}" CommandParameter="全部" GroupName="PreviewFilter" IsChecked="True" Style="{StaticResource PreviewFilterRadioStyle}" AutomationProperties.Name="显示全部结果"/>
                <RadioButton Content="{Binding SubmittablePreviewFilterText}" Command="{Binding PreviewFilterCommand}" CommandParameter="可提交" GroupName="PreviewFilter" Style="{StaticResource PreviewFilterRadioStyle}" AutomationProperties.Name="只显示可提交结果"/>
                <RadioButton Content="{Binding BlankPreviewFilterText}" Command="{Binding PreviewFilterCommand}" CommandParameter="未填写" GroupName="PreviewFilter" Style="{StaticResource PreviewFilterRadioStyle}" AutomationProperties.Name="只显示未填写结果"/>
                <RadioButton Content="{Binding StalePreviewFilterText}" Command="{Binding PreviewFilterCommand}" CommandParameter="状态变化" GroupName="PreviewFilter" Style="{StaticResource PreviewFilterRadioStyle}" AutomationProperties.Name="只显示状态变化结果"/>
                <RadioButton Content="{Binding InvalidPreviewFilterText}" Command="{Binding PreviewFilterCommand}" CommandParameter="填写错误" GroupName="PreviewFilter" Style="{StaticResource PreviewFilterRadioStyle}" AutomationProperties.Name="只显示填写错误结果"/>
            </StackPanel>
        </StackPanel>
        <DataGrid Grid.Row="1" Margin="0,8" ItemsSource="{Binding VisiblePreviewRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource TableDividerBrush}" VerticalGridLinesBrush="{DynamicResource TableDividerBrush}" BorderBrush="{DynamicResource TableDividerBrush}" HeadersVisibility="Column" SelectionUnit="Cell" SelectionMode="Single"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  AutomationProperties.Name="排查结果确认明细">
            <DataGrid.Columns>
                <DataGridTextColumn Header="条码" Binding="{Binding ProductBarcode}" Width="125" HeaderStyle="{StaticResource ConfirmationGridHeaderStyle}" ElementStyle="{StaticResource ConfirmationCellTextStyle}"/>
                <DataGridTemplateColumn Header="商品名称" Width="160" HeaderStyle="{StaticResource ConfirmationGridHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="当前阶段" Width="72" HeaderStyle="{StaticResource ConfirmationGridCenterHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource StageBadgeTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="生产日期" Binding="{Binding ProductionDate}" Width="90" HeaderStyle="{StaticResource ConfirmationGridCenterHeaderStyle}" ElementStyle="{StaticResource ConfirmationCellCenterTextStyle}"/>
                <DataGridTextColumn Header="有效日期" Binding="{Binding ExpiryDate}" Width="90" HeaderStyle="{StaticResource ConfirmationGridCenterHeaderStyle}" ElementStyle="{StaticResource ConfirmationCellCenterTextStyle}"/>
                <DataGridTextColumn Header="本次排查数量" Binding="{Binding CheckedQtyText}" Width="96" HeaderStyle="{StaticResource ConfirmationGridCenterHeaderStyle}" ElementStyle="{StaticResource ConfirmationCellCenterTextStyle}"/>
                <DataGridTextColumn Header="处理结果" Binding="{Binding ResultText}" Width="84" HeaderStyle="{StaticResource ConfirmationGridCenterHeaderStyle}" ElementStyle="{StaticResource ConfirmationCellCenterTextStyle}"/>
                <DataGridTemplateColumn Header="原因" Width="*" HeaderStyle="{StaticResource ConfirmationGridHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DisplayReason}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers><DataTrigger Binding="{Binding HasIssue}" Value="True"><Setter Property="Background" Value="#FFFDE7E7"/></DataTrigger></Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="180"/><ColumnDefinition Width="72"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="排查人" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource ConfirmationInspectorTextBoxStyle}" Text="{Binding InspectorName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" VerticalContentAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="排查人"/>
            <TextBlock Grid.Column="2" Text="排查日期" Margin="12,0,0,0" VerticalAlignment="Center"/><DatePicker Grid.Column="3" Style="{StaticResource ConfirmationDatePickerStyle}" SelectedDate="{Binding CheckDateValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayDateEnd="{Binding CheckDateMaxValue, Mode=OneWay}" SelectedDateFormat="Short" VerticalAlignment="Center" AutomationProperties.Name="排查日期"/>
            <TextBlock Grid.Column="4" Text="不晚于今天" Margin="12,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InspectorNameError}" Foreground="{DynamicResource DangerBrush}" FontSize="12"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CheckDateError}" Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Width="88" Margin="0,0,8,0"/>
            <Button Content="提交数据" Click="Submit_Click" IsDefault="True" Width="104" AutomationProperties.Name="提交排查数据"/>
        </StackPanel>
    </Grid>
</Window>
