<Window x:Class="StoreExpiryInspector.UI.TodayInspectionConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="排查结果确认" Width="980" Height="660" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="排查结果确认" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PreviewSummaryText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <DataGrid Grid.Row="1" Margin="0,12" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="All" HeadersVisibility="Column" SelectionUnit="Cell" SelectionMode="Single"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  AutomationProperties.Name="排查结果确认明细">
            <DataGrid.Columns>
                <DataGridTextColumn Header="条码" Binding="{Binding ProductBarcode}" Width="150"/>
                <DataGridTemplateColumn Header="商品名称" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductName}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="生产日期" Binding="{Binding ProductionDate}" Width="105"/>
                <DataGridTextColumn Header="有效日期" Binding="{Binding ExpiryDate}" Width="105"/>
                <DataGridTextColumn Header="本次排查数量" Binding="{Binding CheckedQtyText}" Width="110"/>
                <DataGridTemplateColumn Header="校验状态" Width="118"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" ToolTip="{Binding Reason}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="180"/><ColumnDefinition Width="72"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="排查人" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding InspectorName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" VerticalContentAlignment="Center" AutomationProperties.Name="排查人"/>
            <TextBlock Grid.Column="2" Text="排查日期" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding CheckDateText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" AutomationProperties.Name="排查日期，yyyy-MM-dd"/>
            <TextBlock Grid.Column="4" Text="日期不得晚于今天" Margin="12,0" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Width="88" Margin="0,0,8,0"/>
            <Button Content="提交数据" Click="Submit_Click" IsDefault="True" Width="104" AutomationProperties.Name="提交排查数据"/>
        </StackPanel>
    </Grid>
</Window>
